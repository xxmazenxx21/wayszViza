---
/**
 * Visa Services — hero (brief v3 §5 = v2: page title «خدمات التأشيرات» + the intro text, word for word).
 * Scene: motion/scenes/airport-hero.ts. The footage (the drone approach to the terminal, then its glass doors) is the page's
 * film layer behind this section (VisaServicesPage.astro). The title words rise from a mask (data-intro on the h1 only);
 * the intro is painted at once and never hidden (LCP). The still behind it fills the screen, so the text stays the
 * largest paint.
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  ar: {
    title: 'خدمات التأشيرات',
    lead: 'سواء كنت تسافر للدراسة أو العمل أو حضور مؤتمر، أو لزيارة عائلتك أو الإقامة بالخارج، نساعدك على فهم متطلبات تأشيرتك وتجهيز ملفك خطوة بخطوة.',
  },
  en: {
    title: 'Visa services',
    lead: 'Whether you are traveling to study, work or attend a conference, or to visit your family or live abroad, we help you understand your visa requirements and prepare your file step by step.',
  },
}[lang];
---
<section class="thero" data-scene="airport-hero" data-shot data-waypoint aria-labelledby="thero-title">
  <div class="thero__sticky">
    <div class="thero__scrim" aria-hidden="true"></div>
    <div class="thero__content container">
      <h1 class="thero__title" id="thero-title" data-intro>{copy.title}</h1>
      <p class="thero__lead">{copy.lead}</p>
    </div>
  </div>
</section>

<style>
  .thero { position: relative; }
  .thero__sticky { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; }
  :global(.js) .thero { height: 240vh; height: 240lvh; }
  :global(.js) .thero__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; min-height: 34rem; }
  :global(.js) .thero__content { padding-block-end: calc(100lvh - 100svh + var(--space-8)); }

  /* a local gradient behind the text only (the footage stays natural on the free side). Strong enough for AA over the
     brightest frames (the poster's sky and roofs): lead ≥ 4.5:1, title ≥ 3:1 — poster, css tier and the WebGL film. */
  .thero__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 86%, transparent) 0%, color-mix(in srgb, var(--color-bg) 72%, transparent) 38%, color-mix(in srgb, var(--color-bg) 52%, transparent) 56%, transparent 80%);
  }
  @media (min-width: 1024px) {
    .thero__sticky { align-items: center; }
    .thero__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 82%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 38%, color-mix(in srgb, var(--color-bg) 44%, transparent) 54%, transparent 74%); }
    :global([dir='rtl']) .thero__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 82%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 38%, color-mix(in srgb, var(--color-bg) 44%, transparent) 54%, transparent 74%); }
  }

  .thero__content { position: relative; z-index: 2; padding-block: calc(76px + var(--space-7)) var(--space-8); }
  .thero__title { max-width: 11ch; font-size: clamp(2.8rem, 1.2rem + 6.4vw, 7rem); line-height: 1.04; letter-spacing: -0.02em; }
  :global([dir='rtl']) .thero__title { letter-spacing: 0; line-height: 1.3; }
  .thero__lead { margin-block-start: var(--space-5); max-width: 44ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  @media (max-width: 639px) { .thero__lead { font-size: var(--text-base); } }
</style>
