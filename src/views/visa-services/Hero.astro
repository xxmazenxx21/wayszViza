---
/**
 * Visa Services — hero (brief part 04 §2: page title «خدمات التأشيرات» + the intro text, word for word).
 * Scene: motion/scenes/terminal-hero.ts. The terminal is drawn by the act `terminal` in the page's stage host.
 * The title words rise from a mask (data-intro on the h1 only); the intro is painted at once and never hidden (LCP).
 * Scrolling: the text leaves, the glass doors slide open and the camera glides in. css tier / no JS: our still of the
 * terminal (full screen behind the text, so the text stays the largest paint).
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  ar: {
    title: 'خدمات التأشيرات',
    lead: 'سواء كنت تسافر للدراسة أو العمل أو حضور مؤتمر، أو لزيارة عائلتك أو الإقامة بالخارج، نساعدك على فهم متطلبات تأشيرتك وتجهيز ملفك خطوة بخطوة.',
  },
  en: {
    title: 'Visa services',
    lead: 'Whether you are traveling to study, work or attend a conference, or to visit your family or live abroad, we help you understand your visa requirements and prepare your file step by step.',
  },
}[lang];
---
<section class="thero" data-scene="terminal-hero" data-shot data-waypoint aria-labelledby="thero-title">
  <div class="thero__sticky">
    <div class="thero__still term-still" aria-hidden="true">
      <picture>
        <source media="(max-width: 1023px)" srcset="/media/img/terminal-hero-m.webp" width="780" height="1688" />
        <img src="/media/img/terminal-hero.webp" alt="" width="1600" height="1000" decoding="async" fetchpriority="high" />
      </picture>
    </div>
    <div class="thero__scrim" aria-hidden="true"></div>
    <div class="thero__content container">
      <h1 class="thero__title" id="thero-title" data-intro>{copy.title}</h1>
      <p class="thero__lead">{copy.lead}</p>
    </div>
  </div>
</section>

<style>
  .thero { position: relative; }
  .thero__sticky { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; }
  :global(.js) .thero { height: 200vh; height: 200lvh; }
  :global(.js) .thero__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; min-height: 34rem; }
  :global(.js) .thero__content { padding-block-end: calc(100lvh - 100svh + var(--space-8)); }

  /* the still (never mirrored) fills the screen behind the text: it is a background, the text is the LCP */
  .thero__still { position: absolute; inset: 0; pointer-events: none; }
  .thero__still img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .thero__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 38%, transparent 66%);
  }
  @media (min-width: 1024px) {
    .thero__sticky { align-items: center; }
    .thero__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 86%, transparent) 0%, color-mix(in srgb, var(--color-bg) 50%, transparent) 36%, transparent 60%); }
    :global([dir='rtl']) .thero__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 86%, transparent) 0%, color-mix(in srgb, var(--color-bg) 50%, transparent) 36%, transparent 60%); }
  }

  .thero__content { position: relative; z-index: 2; padding-block: calc(76px + var(--space-7)) var(--space-8); }
  .thero__title { max-width: 11ch; font-size: clamp(2.8rem, 1.2rem + 6.4vw, 7rem); line-height: 1.04; letter-spacing: -0.02em; }
  :global([dir='rtl']) .thero__title { letter-spacing: 0; line-height: 1.3; }
  .thero__lead { margin-block-start: var(--space-5); max-width: 44ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 90%, transparent); }
  @media (max-width: 639px) { .thero__lead { font-size: var(--text-base); } }
</style>
