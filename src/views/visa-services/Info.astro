---
/**
 * Visa Services — «لست متأكدًا من نوع تأشيرتك؟» (brief part 04 §2.2, the last card) + text + «اطلب استشارة ←».
 * The camera rests at the information desk with its glowing "i" (act `terminal`). Scene: terminal-info.
 * css tier / no JS: our still of the desk.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: { title: 'لست متأكدًا من نوع تأشيرتك؟', text: 'أخبرنا بغرض سفرك ووجهتك ومدة إقامتك، وسنساعدك على تحديد الفئة المناسبة ومتطلباتها قبل أن تبدأ.' },
  en: { title: 'Not sure which visa you need?', text: 'Tell us the purpose of your trip, your destination and how long you plan to stay, and we’ll help you identify the right category and its requirements before you start.' },
}[lang];
---
<section class="tinfo" data-scene="terminal-info" data-shot data-waypoint aria-labelledby="tinfo-title">
  <div class="tinfo__sticky">
    <div class="tinfo__still term-still" aria-hidden="true">
      <img src="/media/img/terminal-info.webp" alt="" width="1000" height="1000" loading="lazy" decoding="async" />
    </div>
    <div class="tinfo__in container">
      <div class="tinfo__card">
        <h2 class="tinfo__title" id="tinfo-title">{copy.title}</h2>
        <p class="tinfo__text">{copy.text}</p>
        <a class="link-arrow tinfo__link" href={localizePath('/consultation/', lang)}>
          {t.cta.request}
          <svg class="icon-dir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .tinfo { position: relative; }
  .tinfo__sticky { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; }
  :global(.js) .tinfo { height: 170vh; height: 170lvh; }
  :global(.js) .tinfo__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }
  .tinfo__still { position: absolute; inset: 0; pointer-events: none; }
  .tinfo__still img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @media (min-width: 1024px) {
    .tinfo__sticky { align-items: center; }
    .tinfo__still { inset-inline-start: 34%; -webkit-mask: radial-gradient(closest-side, black 70%, transparent); mask: radial-gradient(closest-side, black 70%, transparent); }
    .tinfo__still img { object-fit: contain; }
  }
  .tinfo__sticky::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 90%, transparent) 0%, color-mix(in srgb, var(--color-bg) 40%, transparent) 42%, transparent 64%);
  }
  .tinfo__in { position: relative; z-index: 2; padding-block: var(--section-y) var(--space-8); }
  .tinfo__card {
    max-width: 30rem; padding: var(--space-7) var(--space-6); border-radius: var(--radius-lg);
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-brand) 88%, transparent), color-mix(in srgb, var(--color-bg) 90%, transparent));
    border: 1px solid color-mix(in srgb, var(--color-accent) 36%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent), 0 24px 60px color-mix(in srgb, var(--color-bg) 60%, transparent);
  }
  .tinfo__title { font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem); line-height: 1.3; }
  .tinfo__text { margin-block-start: var(--space-4); font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 90%, transparent); }
  .tinfo__link { margin-block-start: var(--space-5); color: var(--color-link); font-weight: var(--weight-bold); text-decoration: none; }
  @media (max-width: 639px) { .tinfo__card { padding: var(--space-6) var(--space-5); } .tinfo__text { font-size: var(--text-base); } }
</style>
