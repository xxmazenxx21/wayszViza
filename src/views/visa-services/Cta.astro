---
/**
 * Visa Services §2.4 «زر طلب الاستشارة» — «جاهز لتحديد طريقك؟» + text + «اطلب استشارة» (brief v3 §5 = v2, word for word).
 * Scene: motion/scenes/airport-cta.ts. The end of the walk: a big terminal window at dusk; scrolling, a plane takes off
 * and climbs away (the takeoff chapter — act `airport`, mode finale, in this section's own stage host; the shader draws
 * the window mullions). The call rises as the plane leaves the ground. Magnetic button. css tier: the same frames on a
 * 2D canvas behind CSS mullions. No JS: the first frame as a still.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: { title: 'جاهز لتحديد طريقك؟', text: 'أخبرنا بغرض سفرك ووجهتك، وسنساعدك على تحديد التأشيرة المناسبة وتجهيز ملفك.' },
  en: { title: 'Ready to choose your path?', text: 'Tell us the purpose of your trip and your destination, and we’ll help you identify the right visa and prepare your file.' },
}[lang];
---
<section class="tcta theme-dark" data-scene="airport-cta" data-waypoint aria-labelledby="tcta-title">
  <div class="tcta__sticky">
    <picture class="tcta__still" aria-hidden="true">
      <source media="(max-width: 1023px)" srcset="/media/video/airport-takeoff-poster-m.webp" width="816" height="1440" />
      <img src="/media/video/airport-takeoff-poster.webp" srcset="/media/video/airport-takeoff-poster.webp 1920w, /media/video/airport-takeoff-poster-hd.webp 2560w" sizes="100vw" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    </picture>
    <canvas class="tcta__canvas" aria-hidden="true"></canvas>
    <div class="tcta__window" aria-hidden="true"></div>
    <div class="tcta__stage stage-host" aria-hidden="true"></div>
    <div class="tcta__scrim" aria-hidden="true"></div>
    <div class="tcta__in container">
      <h2 class="tcta__title" id="tcta-title">{copy.title}</h2>
      <p class="tcta__lead">{copy.text}</p>
      <a class="btn btn--accent tcta__btn" href={localizePath('/consultation/', lang)} data-magnetic>{t.cta.request}</a>
    </div>
  </div>
</section>

<style>
  .tcta { position: relative; background: var(--color-bg); }
  .tcta__sticky { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; background: var(--color-bg); }
  :global(.js) .tcta { height: 240vh; height: 240lvh; }
  :global(.js) .tcta__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }
  .tcta__still, .tcta__canvas, .tcta__window, .tcta__stage, .tcta__scrim { position: absolute; inset: 0; }
  .tcta__still img { width: 100%; height: 100%; object-fit: cover; }   /* never mirrored */
  .tcta__canvas { width: 100%; height: 100%; display: none; }
  .tcta:global(.is-scrub.is-painted) .tcta__canvas { display: block; }   /* opaque 2D copy: only once it has a frame */
  .tcta:global(.is-painted) .tcta__still { visibility: hidden; }
  /* the window of the css tier / no JS (the WebGL finale draws its own mullions, with parallax) */
  .tcta__window {
    pointer-events: none;
    --bar: color-mix(in srgb, var(--color-bg) 78%, black);
    background:
      linear-gradient(to top, var(--bar) 7.5%, transparent 7.5%),
      linear-gradient(to bottom, transparent calc(20% - 6px), var(--bar) calc(20% - 6px), var(--bar) calc(20% + 6px), transparent calc(20% + 6px)),
      linear-gradient(to right, transparent calc(50% - 8px), var(--bar) calc(50% - 8px), var(--bar) calc(50% + 8px), transparent calc(50% + 8px));
  }
  @media (min-width: 1024px) {
    .tcta__window {
      background:
        linear-gradient(to top, var(--bar) 7.5%, transparent 7.5%),
        linear-gradient(to bottom, transparent calc(20% - 6px), var(--bar) calc(20% - 6px), var(--bar) calc(20% + 6px), transparent calc(20% + 6px)),
        linear-gradient(to right, transparent calc(17% - 8px), var(--bar) calc(17% - 8px), var(--bar) calc(17% + 8px), transparent calc(17% + 8px),
                                  transparent calc(50% - 8px), var(--bar) calc(50% - 8px), var(--bar) calc(50% + 8px), transparent calc(50% + 8px),
                                  transparent calc(83% - 8px), var(--bar) calc(83% - 8px), var(--bar) calc(83% + 8px), transparent calc(83% + 8px));
    }
  }
  .tcta__stage { z-index: 1; }
  .tcta__sticky:has(.tcta__stage.is-drawing) :is(.tcta__still, .tcta__canvas, .tcta__window) { visibility: hidden; }
  html:not(.js) .tcta__stage { display: none; }
  /* AA over the brightest sunset frames (title ≥ 3:1, lead ≥ 4.5:1) — the plane's side stays natural */
  .tcta__scrim { z-index: 1; pointer-events: none; background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 86%, transparent) 0%, color-mix(in srgb, var(--color-bg) 72%, transparent) 38%, color-mix(in srgb, var(--color-bg) 52%, transparent) 56%, transparent 80%); }
  @media (min-width: 1024px) {
    .tcta__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 82%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 38%, color-mix(in srgb, var(--color-bg) 44%, transparent) 54%, transparent 74%); }
    :global([dir='rtl']) .tcta__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 82%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 38%, color-mix(in srgb, var(--color-bg) 44%, transparent) 54%, transparent 74%); }
  }
  .tcta__in { position: relative; z-index: 2; padding-block: var(--section-y) calc(var(--space-8) + 100lvh - 100svh); }
  @media (min-width: 1024px) { .tcta__sticky { align-items: center; } }
  .tcta__title { font-size: clamp(2.4rem, 1.2rem + 4.6vw, 5.4rem); line-height: 1.1; max-width: 13ch; }
  :global([dir='rtl']) .tcta__title { line-height: 1.34; }
  .tcta__lead { margin-block-start: var(--space-5); max-width: 38ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  .tcta__btn { margin-block-start: var(--space-6); min-height: 56px; padding-inline: var(--space-7); font-size: var(--text-base); }
</style>
