---
/**
 * Home §1.5b «خدمات إضافية» — «ولأن ملفك يحتاج أكثر من ذلك» + text + the five cards of brief v3 §4 1.5b (the card
 * names and lines are the §4 table's own, shorter than the §3 page names), each linking to its detail page.
 * Scene: motion/scenes/paper-pocket.ts. The booklet's back pocket: five paper slips wait inside it, their tops showing,
 * and fan out of it one after another with the scroll into an arc above it (wide screens: one sticky screen, scrubbed,
 * reversible). Small screens: the slips come out of the pocket one by one as they scroll in. DOM + GSAP, no 3D.
 * No JS: the pocket and the five slips laid out as a plain list.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: {
    title: 'ولأن ملفك يحتاج أكثر من ذلك',
    text: 'خدمات تكمّل رحلتك من أول سؤال حتى يوم موعدك.',
    cards: [
      ['refusal-review', 'مراجعة الرفض وإعادة التقديم', 'نقرأ أسباب الرفض معك، ونبني ملفًا أقوى للتقديم التالي.'],
      ['appointment-booking', 'المساعدة في حجز الموعد', 'نساعدك على حجز موعد التقديم في الجهة المعتمدة وفق المتاح.'],
      ['travel-bookings', 'حجوزات وتأمين السفر', 'حجوزات طيران وفندق وتأمين سفر تناسب متطلبات ملفك.'],
      ['translation-attestation', 'الترجمة والتوثيق', 'ترجمة معتمدة لمستنداتك وتوجيه في خطوات توثيقها.'],
      ['corporate-visas', 'تأشيرات الشركات والوفود', 'تنسيق ملفات تأشيرات فرق العمل والوفود في مكان واحد.'],
    ],
  },
  en: {
    title: 'Because your file needs more than that',
    text: 'Services that complete your journey, from your first question to your appointment day.',
    cards: [
      ['refusal-review', 'Refusal review & reapplication', 'We read the refusal reasons with you and build a stronger file for your next application.'],
      ['appointment-booking', 'Appointment booking assistance', 'We help you book your submission appointment with the authorized center, subject to availability.'],
      ['travel-bookings', 'Travel bookings & insurance', 'Flight, hotel and travel insurance arranged to suit your file’s requirements.'],
      ['translation-attestation', 'Translation & attestation', 'Certified translation of your documents and guidance on attesting them.'],
      ['corporate-visas', 'Corporate & delegation visas', 'Visa files for teams and delegations, coordinated in one place.'],
    ],
  },
}[lang];
// our own line icons (24 × 24, stroke): a returned letter · a calendar with a tick · a boarding ticket · two sheets with a
// swap · a group with a case
const icons: Record<string, string> = {
  'refusal-review': 'M6 3h9l4 4v14H6zM15 3v4h4M9.5 15.5a3 3 0 1 0 1-4.6M9 9.5v2.2h2.2',
  'appointment-booking': 'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5M9 15l2 2 4-4',
  'travel-bookings': 'M3 7h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4zM14 7v10M7 11l2.5 1L7 13.5M7 12h4',
  'translation-attestation': 'M4 4h9v12H4zM11 8h9v12h-9M7 8h3M7 11h3M14 13h3M14 16h3',
  'corporate-visas': 'M8.5 8a2.5 2.5 0 1 0 0-.1M15.5 8a2.5 2.5 0 1 0 0-.1M3.5 17c.5-3 2.5-4.5 5-4.5s4.5 1.5 5 4.5M13 13c.8-.4 1.6-.5 2.5-.5 2.5 0 4.5 1.5 5 4.5',
};
---
<section class="pxtra theme-dark" data-scene="paper-pocket" data-waypoint aria-labelledby="pxtra-title">
  <div class="pxtra__sticky">
    <div class="pxtra__in container">
      <header class="pxtra__head">
        <h2 class="pxtra__title" id="pxtra-title">{copy.title}</h2>
        <p class="pxtra__text">{copy.text}</p>
      </header>
      <div class="pxtra__desk">
        <div class="pxtra__pocket pxtra__pocket--back" aria-hidden="true"></div>
        <ul class="pxtra__slips" role="list">
          {copy.cards.map(([slug, name, line], i) => (
            <li class="pxtra__slip" style={`--i: ${i}`}>
              <a class="pxtra__card theme-light" href={localizePath(`/visa-services/${slug}/`, lang)}>
                <svg class="pxtra__icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d={icons[slug]} /></svg>
                <h3 class="pxtra__name">{name}</h3>
                <p class="pxtra__line">{line}</p>
                <span class="pxtra__more" aria-hidden="true">
                  {t.cta.details}
                  <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="pxtra__pocket pxtra__pocket--front" aria-hidden="true">
          <svg class="pxtra__mark" viewBox="0 0 120 40"><path d="M10 30 C 40 30, 70 22, 110 8" /><path class="pxtra__mark-plane" d="M110 8 96 17l3-6-6-4 17 1Z" /></svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pxtra { position: relative; overflow: clip; background: var(--color-bg); }
  .pxtra__in { position: relative; padding-block: var(--section-y); }
  .pxtra__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.25; max-width: 20ch; }
  :global([dir='rtl']) .pxtra__title { line-height: 1.4; }
  .pxtra__text { margin-block-start: var(--space-4); max-width: 42ch; font-size: var(--text-lg); line-height: 1.8; color: var(--color-ink-muted); }

  /* the desk: the pocket behind, the slips, the pocket's front face over their lower part */
  .pxtra__desk { position: relative; margin-block-start: var(--space-7); }
  .pxtra__slips { position: relative; z-index: 2; display: grid; gap: var(--space-4); }
  .pxtra__slip { position: relative; }
  .pxtra__card {
    position: relative; display: grid; gap: var(--space-2); align-content: start; height: 100%;
    padding: var(--space-6) var(--space-5) var(--space-5); border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 50% 0, transparent 7px, var(--color-surface) 7.5px) top / 100% 51% no-repeat,
      linear-gradient(var(--color-surface), var(--color-bg-alt)) bottom / 100% 50% no-repeat;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 6%, transparent), 0 18px 40px -18px color-mix(in srgb, black 70%, transparent);
    text-decoration: none; color: var(--color-ink);
    transition: translate var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  /* the slip's perforated stub line (paper, not a template card) */
  .pxtra__card::after {
    content: ''; position: absolute; inset-inline: var(--space-4); top: 2.75rem;
    border-block-start: 1.5px dashed color-mix(in srgb, var(--color-ink) 16%, transparent);
  }
  .pxtra__card:hover, .pxtra__card:focus-visible { translate: 0 -6px; box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ink) 6%, transparent), 0 26px 50px -18px color-mix(in srgb, black 75%, transparent); }
  .pxtra__icon { position: absolute; top: 0.55rem; inset-inline-start: var(--space-4); fill: none; stroke: var(--color-accent-ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .pxtra__name { margin-block-start: var(--space-3); font-size: var(--text-lg); line-height: 1.4; }
  .pxtra__line { color: var(--color-ink-muted); line-height: 1.75; font-size: var(--text-sm); }
  .pxtra__more { display: inline-flex; align-items: center; gap: var(--space-2); margin-block-start: var(--space-2); font-size: var(--text-sm); font-weight: var(--weight-bold); color: var(--color-accent-ink); }

  /* the pocket: navy leather like the booklet's cover, a sky thread stitched along its edge, the plane of the mark */
  .pxtra__pocket { display: none; }

  @media (max-width: 1023px) {
    .pxtra__slips { gap: var(--space-4); }
    .pxtra__slip:nth-child(odd) .pxtra__card { margin-inline-end: var(--space-5); }
    .pxtra__slip:nth-child(even) .pxtra__card { margin-inline-start: var(--space-5); }
  }

  @media (min-width: 1024px) {
    .pxtra__slips { grid-template-columns: repeat(5, 1fr); gap: var(--space-5); }
    .pxtra__card { min-height: 19rem; padding: var(--space-7) var(--space-5) var(--space-6); }
    .pxtra__card::after { top: 3.1rem; }
    .pxtra__icon { top: 0.75rem; }
    .pxtra__name { font-size: var(--text-xl); }
    .pxtra__line { font-size: var(--text-base); }
    .pxtra:global(.is-scrub) .pxtra__pocket { display: block; }
    .pxtra__pocket { position: absolute; inset-inline: 0; margin-inline: auto; width: min(30rem, 44%); bottom: -2rem; }
    .pxtra__pocket--back { z-index: 1; height: 9rem; border-radius: var(--radius-md) var(--radius-md) 0 0; background: color-mix(in srgb, var(--color-surface) 70%, black); }
    .pxtra__pocket--front {
      z-index: 3; height: 7.5rem; border-radius: 50% 50% 0 0 / 1.6rem 1.6rem 0 0;
      background: linear-gradient(to bottom, color-mix(in srgb, var(--color-surface) 92%, var(--color-ink)), var(--color-surface) 30%, var(--color-bg-alt));
      box-shadow: 0 -10px 30px -12px color-mix(in srgb, black 70%, transparent), inset 0 1px 0 color-mix(in srgb, var(--color-ink) 18%, transparent);
    }
    .pxtra__pocket--front::before {
      content: ''; position: absolute; inset: 0.7rem 0.8rem 0; border-radius: 50% 50% 0 0 / 1.2rem 1.2rem 0 0;
      border: 2px dashed color-mix(in srgb, var(--color-accent) 70%, transparent); border-block-end: 0;
    }
    .pxtra__mark { position: absolute; inset: 0; margin: auto; width: 7.5rem; height: 2.5rem; fill: none; stroke: color-mix(in srgb, var(--color-accent) 60%, transparent); stroke-width: 1.6; stroke-dasharray: 2 5; stroke-linecap: round; }
    .pxtra__mark-plane { fill: var(--color-accent); stroke: none; }
    :global([dir='rtl']) .pxtra__mark { scale: -1 1; }

    /* with JS: one sticky screen — the slips start inside the pocket and fan out into an arc above it */
    .pxtra:global(.is-scrub) { height: 270vh; height: 270lvh; }
    .pxtra:global(.is-scrub) .pxtra__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }
    .pxtra:global(.is-scrub) .pxtra__in { height: 100%; display: grid; grid-template-rows: auto 1fr; padding-block: calc(76px + var(--space-6)) 0; }
    .pxtra:global(.is-scrub) .pxtra__desk { display: grid; align-items: center; margin-block-start: var(--space-4); padding-block-end: 8rem; }
    .pxtra:global(.is-scrub) .pxtra__pocket { bottom: 0; }
    .pxtra:global(.is-scrub) .pxtra__slip { will-change: transform; }
  }
</style>
