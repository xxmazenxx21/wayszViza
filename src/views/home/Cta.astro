---
/**
 * Home §1.8 «زر بدء الاستشارة» — «جاهز لبدء رحلتك؟» + text + «ابدأ استشارتك» (brief part 04).
 * Scene: motion/scenes/paper-cta.ts. The booklet returns closed in its own stage host (act `paper`, mode finale):
 * a sky-blue ribbon bookmark slides out, then the only seal on the page lands once — «ملف جاهز» / "File ready"
 * (DOM, SVG; never an "approved" stamp: we prepare files, the embassy decides). Magnetic button.
 * css tier / no JS: our still of the closed booklet with its ribbon; the seal is shown.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: { title: 'جاهز لبدء رحلتك؟', text: 'ابدأ استشارتك الآن، ودعنا نساعدك على التقديم وأنت أكثر استعدادًا.', seal: 'ملف جاهز' },
  en: { title: 'Ready to start your journey?', text: 'Start your consultation now, and let us help you apply better prepared.', seal: 'File ready' },
}[lang];
---
<section class="pcta theme-dark" data-scene="paper-cta" data-waypoint aria-labelledby="pcta-title">
  <div class="pcta__stage stage-host" aria-hidden="true"></div>
  <div class="pcta__still paper-still" aria-hidden="true">
    <img src="/media/img/paper-finale.webp" alt="" width="1100" height="1100" loading="lazy" decoding="async" />
  </div>
  <div class="pcta__scrim" aria-hidden="true"></div>
  <div class="pcta__in container">
    <div class="pcta__text">
      <h2 class="pcta__title" id="pcta-title">{copy.title}</h2>
      <p class="pcta__lead">{copy.text}</p>
      <a class="btn btn--accent pcta__btn" href={localizePath('/consultation/', lang)} data-magnetic>{t.cta.start}</a>
    </div>
    <div class="pcta__seal-box" aria-hidden="true">
      <svg class="pcta__seal" viewBox="0 0 160 160">
        <circle cx="80" cy="80" r="74" /><circle cx="80" cy="80" r="66" stroke-dasharray="2 5" />
        <path class="pcta__seal-check" d="M58 64l14 14 30-30" />
        <text x="80" y="118" text-anchor="middle">{copy.seal}</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .pcta { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: center; background: var(--color-bg); }
  .pcta__stage, .pcta__still, .pcta__scrim { position: absolute; inset: 0; }
  .pcta__still img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @media (min-width: 1024px) {
    .pcta__still { inset-inline-start: 44%; -webkit-mask: radial-gradient(closest-side, black 70%, transparent); mask: radial-gradient(closest-side, black 70%, transparent); }
    .pcta__still img { object-fit: contain; }
  }
  html:not(.js) .pcta__stage { display: none; }
  .pcta__scrim { pointer-events: none; background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 92%, transparent) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 42%, transparent 70%); }
  @media (min-width: 1024px) {
    .pcta__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 85%, transparent) 0%, color-mix(in srgb, var(--color-bg) 40%, transparent) 40%, transparent 60%); }
    :global([dir='rtl']) .pcta__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 85%, transparent) 0%, color-mix(in srgb, var(--color-bg) 40%, transparent) 40%, transparent 60%); }
  }
  .pcta__in { position: relative; z-index: 2; display: grid; gap: var(--space-6); padding-block: var(--section-y); align-self: end; }
  @media (min-width: 1024px) { .pcta__in { grid-template-columns: 1fr 1fr; align-items: center; align-self: center; } }
  .pcta__title { font-size: clamp(2.4rem, 1.2rem + 4.4vw, 5.2rem); line-height: 1.12; max-width: 14ch; }
  :global([dir='rtl']) .pcta__title { line-height: 1.34; }
  .pcta__lead { margin-block-start: var(--space-5); max-width: 40ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 90%, transparent); }
  .pcta__btn { margin-block-start: var(--space-6); min-height: 56px; padding-inline: var(--space-7); font-size: var(--text-base); }
  /* the seal sits over the booklet (the free side on wide screens, above the text on phones) */
  .pcta__seal-box { order: -1; justify-self: end; }
  @media (min-width: 1024px) { .pcta__seal-box { order: 0; justify-self: center; translate: 30% 55%; } }
  .pcta__seal { width: clamp(6.5rem, 4rem + 8vw, 10rem); overflow: visible; fill: none; stroke: var(--color-accent); stroke-width: 3; rotate: -10deg; filter: drop-shadow(0 6px 18px color-mix(in srgb, var(--color-bg) 80%, transparent)); }
  .pcta__seal-check { stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .pcta__seal text { fill: var(--color-accent); stroke: none; font: var(--weight-bold) 19px var(--font-display); }
</style>
