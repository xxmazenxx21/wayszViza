---
/**
 * Home — FAQ: the eight questions of brief v3 §19.1 (final list), word for word.
 * Scenes: accordion (open / close) + paper-faq (closed answers `inert`, the rows arrive once). No JS: all open.
 */
import { useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = {
  ar: [
    ['كيف تساعدونني على تقوية فرص قبول طلبي؟', 'نبني ملفك على غرض سفرك الحقيقي: نوع التأشيرة الصحيح، ومستندات مرتبة ومتسقة، وخطاب غرض واضح، واستعداد جيد للموعد والمقابلة. الملف القوي هو أفضل ما تقدمه لنفسك.'],
    ['متى أبدأ التجهيز قبل موعد سفري؟', 'كلما بدأت مبكرًا كان أفضل؛ فمواعيد التقديم ومدة دراسة الطلبات تختلف من دولة لأخرى ومن موسم لآخر. نرتب معك خطواتك لتكون جاهزًا في الوقت المناسب.'],
    ['هل يمكنني التقديم بنفسي دون استشارة؟', 'نعم، في كثير من الحالات. وتفيدك الاستشارة أكثر إذا لم تكن متأكدًا من نوع التأشيرة، أو تسافر لأول مرة، أو سبق رفض طلب لك، أو تريد مراجعة ملفك قبل التقديم.'],
    ['ماذا أجهز قبل جلسة الاستشارة؟', 'يكفي أن تكون المعلومات معك: بيانات جواز سفرك، والدولة التي تقصدها، وموعد سفرك المتوقع وغرضه، وأي خطابات لديك مثل دعوة أو قبول دراسي، وخطاب الرفض إن وُجد. لا ترسل صور المستندات عبر الموقع.'],
    ['سبق رفض طلبي، هل يمكنني التقديم مرة أخرى؟', 'غالبًا نعم. في خدمة «مراجعة الرفض وإعادة التقديم» نقرأ خطاب الرفض معك، ونحدد نقاط الضعف، ونبني ملفًا أقوى قبل أن تتقدم من جديد.'],
    ['هل تحجزون موعد التقديم بدلًا مني؟', 'نعم، نتولى حجز موعدك في الجهة المعتمدة ونختار معك أنسب موعد متاح.'],
    ['هل تخدمون الشركات والوفود؟', 'نعم. ننسق ملفات تأشيرات فرق العمل والمشاركين في المعارض والمؤتمرات في مكان واحد.'],
    ['هل تعملون على برامج الإقامة والجنسية عن طريق الاستثمار؟', 'نعم، بصفتنا وكيلًا معتمدًا. نقارن معك البرامج المتاحة في أوروبا والكاريبي وغيرها، ونرافقك في ملفك حتى صدور القرار.'],
  ],
  en: [
    ['How do you help me strengthen my application?', 'We build your file around your real purpose: the right visa type, organized and consistent documents, a clear cover letter and solid preparation for your appointment and interview. A strong file is the best thing you can bring.'],
    ['How early should I start preparing before my trip?', 'The earlier the better: appointment availability and processing times differ by country and by season. We plan your steps with you so you’re ready on time.'],
    ['Can I apply on my own without a consultation?', 'Yes, in many cases. A consultation helps most when you’re unsure which visa you need, are traveling for the first time, have had a refusal, or want your file reviewed before you apply.'],
    ['What should I prepare before the consultation?', 'Having the information with you is enough: your passport details, destination, expected travel date and purpose, any letters such as an invitation or admission letter, and a refusal letter if there is one. Don’t send copies of documents through the website.'],
    ['My application was refused. Can I apply again?', 'Usually yes. With our «Refusal review & reapplication» service we read the refusal letter with you, pinpoint the weak points and build a stronger file before you apply again.'],
    ['Can you book my submission appointment?', 'Yes, we book your appointment with the authorized center and pick the best available slot with you.'],
    ['Do you work with companies and delegations?', 'Yes. We coordinate visa files for business teams and for exhibition and conference participants, in one place.'],
    ['Do you handle residency and citizenship by investment?', 'Yes, as an authorized agent. We compare the programs in Europe, the Caribbean and beyond with you, and support your file until a decision is made.'],
  ],
}[lang];
---
<section class="pfaq section" data-scene="accordion paper-faq" data-waypoint aria-labelledby="pfaq-title">
  <div class="container pfaq__in">
    <h2 class="pfaq__title" id="pfaq-title">{t.visa.faq}</h2>
    <div class="pfaq__list">
      {items.map(([q, a], i) => (
        <div class="faq__item">
          <h3 class="pfaq__q">
            <button type="button" aria-expanded="false" aria-controls={`pfaq-${i}`}>
              <span>{q}</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </button>
          </h3>
          <div class="faq__panel" id={`pfaq-${i}`}><p class="pfaq__a">{a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pfaq { background: var(--color-bg-alt); }
  .pfaq__in { display: grid; gap: var(--space-7); }
  @media (min-width: 1024px) { .pfaq__in { grid-template-columns: 1fr 2fr; align-items: start; } }
  .pfaq__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.25; }
  .pfaq__list { border-block-start: 1px solid var(--color-border); }
  .pfaq :global(.faq__item) { border-block-end: 1px solid var(--color-border); }
  .pfaq__q { font: inherit; }
  .pfaq__q button {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-5);
    width: 100%; padding-block: var(--space-5); text-align: start;
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-lg); line-height: 1.5;
  }
  .pfaq__q button:hover { color: var(--color-accent-ink); }
  .pfaq__q svg { flex: none; fill: none; stroke: var(--color-accent-ink); stroke-width: 1.8; stroke-linecap: round; transition: rotate var(--dur-base) var(--ease-out); }
  .pfaq__q button[aria-expanded='true'] svg { rotate: 45deg; }
  .pfaq__a { padding-block-end: var(--space-5); color: var(--color-ink-muted); line-height: 1.85; max-width: 62ch; }
</style>
