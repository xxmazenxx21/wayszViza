---
/**
 * Home §1.6b «الوجهات التي نعمل عليها» — «وجهات نرافقك إليها» + text + the countries of brief v3 §1.6b grouped by region
 * (src/data/destinations.ts; names from src/lib/countries.ts, the brief's overrides included). Every name is a link to the
 * consultation form with the country prefilled (`?destination=<ISO>`).
 * The night Earth of the visa template (act `atlas`, «network» mood) turns behind it in the Home's own stage host
 * (`.hatlas__stage`, views/HomePage.astro): scene home-destinations — one sticky screen with a rest per region; the camera
 * flies to the region and rests while its name and countries light up here. A focused link brings its region on screen.
 * css tier: the still globe (`atlas-network`) behind the same rests. No JS: every region and its countries in a list.
 */
import { regions } from '../../data/destinations';
import { countries } from '../../lib/countries';
import { localizePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const form = localizePath('/consultation/', lang);
const copy = {
  ar: {
    title: 'وجهات نرافقك إليها',
    text: 'من أوروبا إلى أمريكا الشمالية وأستراليا، نرافقك إلى وجهتك أيًّا كان غرض سفرك.',
    hint: 'اختر وجهتك، ونفتح لك طلب الاستشارة بها.',
  },
  en: {
    title: 'Destinations we guide you to',
    text: 'From Europe to North America and Australia, we guide you to your destination, whatever your purpose.',
    hint: 'Choose your destination and we’ll open your consultation request with it.',
  },
}[lang];
const list = regions.map((r) => ({
  id: r.id, label: r.label[lang],
  countries: countries(r.countries, lang).map((c) => ({ ...c, href: `${form}?destination=${c.code}` })),
}));
---
<section class="hdest" id="destinations" data-scene="home-destinations" data-shot="destinations" data-waypoint aria-labelledby="hdest-title" style={`--n: ${list.length}`}>
  <header class="hdest__head container">
    <h2 class="hdest__title" id="hdest-title">{copy.title}</h2>
    <p class="hdest__text">{copy.text}</p>
    <p class="hdest__hint" id="hdest-hint">{copy.hint}</p>
  </header>
  <div class="hdest__rests">
    <div class="hdest__sticky">
      <div class="hdest__scrim" aria-hidden="true"></div>
      <div class="hdest__in container">
        <ol class="hdest__index" aria-hidden="true">{list.map((r) => <li>{r.label}</li>)}</ol>
        <ol class="hdest__regions" role="list">
          {list.map((r) => (
            <li class="hdest__region">
              <h3 class="hdest__name">{r.label}</h3>
              <ul class="hdest__list" role="list">
                {r.countries.map((c, k) => (
                  <li style={`--k: ${k}`}><a href={c.href} aria-describedby="hdest-hint">{c.name}</a></li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <div class="hdest__ticks" aria-hidden="true">{list.map(() => <span></span>)}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hdest { position: relative; }
  .hdest__head { position: relative; z-index: 2; padding-block: var(--section-y) var(--space-7); }
  /* the globe rises behind the heading: the navy holds the text, then lets the Earth through */
  .hdest__head::before {
    content: ''; position: absolute; inset: 0 0 -6rem; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, var(--color-bg) 35%, color-mix(in srgb, var(--color-bg) 70%, transparent) 70%, transparent);
  }
  .hdest__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.25; max-width: 16ch; }
  :global([dir='rtl']) .hdest__title { line-height: 1.4; }
  .hdest__text { margin-block-start: var(--space-4); max-width: 42ch; font-size: var(--text-lg); line-height: 1.85; color: color-mix(in srgb, var(--color-ink) 86%, transparent); }
  .hdest__hint { margin-block-start: var(--space-3); max-width: 42ch; color: var(--color-ink-muted); line-height: 1.75; }
  .hdest__in { position: relative; z-index: 2; padding-block-end: var(--section-y); }
  .hdest__index, .hdest__ticks, .hdest__scrim { display: none; }
  .hdest__index { list-style: none; padding: 0; margin: 0; }

  .hdest__regions { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .hdest__name { font-size: var(--text-lg); line-height: 1.45; color: var(--color-link); }
  .hdest__list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block-start: var(--space-3); }
  .hdest__list a {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-4); border-radius: var(--radius-pill);
    color: var(--color-ink); text-decoration: none; font-size: var(--text-sm);
    background: color-mix(in srgb, var(--color-bg) 62%, transparent);
    border: 1px solid var(--color-border); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: color 0.35s var(--ease-out), background-color 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }
  .hdest__list a:hover { border-color: color-mix(in srgb, var(--color-accent) 70%, transparent); background: color-mix(in srgb, var(--color-accent-strong) 30%, var(--color-bg)); }

  /* with JS: one sticky screen, a rest per region; the region panels share one place (opacity only) */
  :global(.js) .hdest__rests { height: calc(100vh + (var(--n) + 0.5) * 38vh); height: calc(100lvh + (var(--n) + 0.5) * 38lvh); }
  :global(.js) .hdest__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; overflow: clip; }
  :global(.js) .hdest__in { height: 100%; display: grid; align-content: end; padding-block: calc(76px + var(--space-5)) calc(var(--space-6) + 64px); }
  :global(.js) .hdest__regions { display: grid; grid-template-columns: 1fr; }
  :global(.js) .hdest__region { grid-area: 1 / 1; align-self: end; opacity: 0; pointer-events: none; transition: opacity 0.5s var(--ease-out); }
  :global(.js) .hdest__region:global(.is-on) { opacity: 1; pointer-events: auto; }
  :global(.js) .hdest__name { font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3rem); line-height: 1.3; color: var(--color-ink); }
  :global(.js) .hdest__list li { opacity: 0; translate: 0 12px; transition: opacity 0.45s var(--ease-out), translate 0.6s var(--ease-out); transition-delay: calc(var(--k) * 35ms); }
  :global(.js) .hdest__region:global(.is-on) .hdest__list li { opacity: 1; translate: 0 0; }
  :global(.js) .hdest__ticks { display: flex; gap: var(--space-2); margin-block-start: var(--space-5); }
  .hdest__ticks span { width: 24px; height: 3px; border-radius: 2px; background: color-mix(in srgb, var(--color-ink) 24%, transparent); transition: background-color 0.4s var(--ease-out), width 0.4s var(--ease-out); }
  .hdest__ticks span:global(.is-on) { width: 44px; background: var(--color-accent); }
  /* the text always sits on a dark gradient (feathered at the top: no line across the globe) */
  :global(.js) .hdest__scrim {
    display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 78%, transparent) 42%, transparent 66%);
  }
  /* the region's countries while it rests: pills on the navy, the visited region's pills in the accent */
  :global(.js) .hdest__region:global(.is-on) .hdest__list a { border-color: color-mix(in srgb, var(--color-accent) 55%, transparent); }

  @media (min-width: 1024px) {
    :global(.js) .hdest__rests { height: calc(100vh + (var(--n) + 0.5) * 46vh); height: calc(100lvh + (var(--n) + 0.5) * 46lvh); }
    :global(.js) .hdest__in { align-content: center; padding-block: calc(76px + var(--space-6)) var(--space-6); }
    :global(.js) .hdest__regions, :global(.js) .hdest__index, :global(.js) .hdest__ticks { max-width: 34rem; }
    :global(.js) .hdest__index { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-block-end: var(--space-6); font-size: var(--text-sm); color: var(--color-ink-muted); }
    .hdest__index li { transition: color 0.4s var(--ease-out); }
    .hdest__index li:global(.is-on) { color: var(--color-link); font-weight: var(--weight-bold); }
    :global(.js) .hdest__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 50%, transparent) 40%, transparent 60%); }
    :global([dir='rtl'].js) .hdest__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 50%, transparent) 40%, transparent 60%); }
    :global(.js) .hdest__head { max-width: none; }
  }
  @media (max-width: 639px) {
    .hdest__list a { min-height: 40px; padding-inline: var(--space-3); }
    :global(.js) .hdest__list { gap: 6px; }
  }
</style>
