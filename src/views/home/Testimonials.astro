---
/**
 * Home §1.6c «آراء العملاء» — «من تجارب عملائنا» + the testimonials of src/data/testimonials.ts (TODO(client): three
 * realistic placeholders until the client sends real ones; `showTestimonials = false` hides the section — HomePage).
 * Each is a postcard home from the trip: the line on the card, the name, the city and the visa type (its name from the
 * JSON) on the address side, a stamp with the plane of the mark. They scroll over the globe of §1.6b as it steps back
 * and fades to plain night (the stage host's last shot, `audience`). Scene: paper-postcards (each card lands with a
 * small turn that settles, scrubbed). No JS: three cards in a row / a column.
 */
import { getCollection } from 'astro:content';
import { testimonials } from '../../data/testimonials';
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const names = Object.fromEntries((await getCollection('visas')).map((e) => [e.id, e.data[lang].name]));
const title = { ar: 'من تجارب عملائنا', en: 'From our clients’ experience' }[lang];
---
<section class="ptest section" data-scene="paper-postcards" data-shot="audience" aria-labelledby="ptest-title">
  <div class="container">
    <h2 class="ptest__title" id="ptest-title">{title}</h2>
    <ul class="ptest__cards" role="list">
      {testimonials.map((item, i) => (
        <li class="ptest__slot" style={`--i: ${i}`}>
          <figure class="ptest__card theme-light">
            <svg class="ptest__stamp" viewBox="0 0 64 76" aria-hidden="true">
              <rect x="4" y="4" width="56" height="68" rx="3" />
              <path class="ptest__stamp-plane" d="M46 30 18 41l5-11-5-11 28 11Z" />
              <path class="ptest__stamp-wave" d="M12 56c6-4 10 4 16 0s10 4 16 0 8 2 8 2" />
            </svg>
            <blockquote class="ptest__quote"><p>{item.quote[lang]}</p></blockquote>
            <figcaption class="ptest__who">
              <span class="ptest__name">{item.name[lang]}</span>
              <span class="ptest__meta">{item.city[lang]}{' · '}{names[item.visa]}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ptest { position: relative; z-index: 2; padding-block-end: calc(var(--section-y) * 1.6); overflow-x: clip; }   /* the cards land tilted: no sideways scroll (in RTL it would move scrollX) */
  .ptest__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.25; text-align: center; text-shadow: 0 2px 24px var(--color-bg); }
  :global([dir='rtl']) .ptest__title { line-height: 1.4; }
  .ptest__cards { display: grid; gap: var(--space-6); margin-block-start: var(--space-8); }
  .ptest__card {
    position: relative; margin: 0; display: grid; align-content: space-between; gap: var(--space-6); height: 100%;
    padding: var(--space-7) var(--space-6) var(--space-6); border-radius: var(--radius-md);
    background: linear-gradient(160deg, var(--color-surface), var(--color-bg-alt)); color: var(--color-ink);
    box-shadow: 0 30px 60px -28px color-mix(in srgb, black 85%, transparent);
  }
  /* the airmail edge of a postcard */
  .ptest__card::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 6px; border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: repeating-linear-gradient(-45deg, var(--color-accent-strong) 0 10px, transparent 10px 18px, var(--color-brand) 18px 28px, transparent 28px 36px);
    opacity: 0.8;
  }
  .ptest__stamp { position: absolute; top: var(--space-5); inset-inline-end: var(--space-5); width: 2.6rem; height: 3.1rem; fill: none; stroke: color-mix(in srgb, var(--color-accent-ink) 70%, transparent); stroke-width: 2; stroke-dasharray: 3 3; rotate: 6deg; }
  .ptest__stamp-plane { fill: var(--color-accent-ink); stroke: none; }
  .ptest__stamp-wave { stroke-dasharray: none; stroke-width: 1.6; }
  .ptest__quote { margin: 0; padding-inline-end: var(--space-8); }
  .ptest__quote p { font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.8; }
  .ptest__quote p::before { content: '«'; color: var(--color-accent-ink); margin-inline-end: 0.15em; }
  .ptest__quote p::after { content: '»'; color: var(--color-accent-ink); margin-inline-start: 0.15em; }
  :global([dir='ltr']) .ptest__quote p::before { content: '“'; }
  :global([dir='ltr']) .ptest__quote p::after { content: '”'; }
  .ptest__who { display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1.5px dashed color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .ptest__name { font-weight: var(--weight-bold); }
  .ptest__meta { font-size: var(--text-sm); color: var(--color-ink-muted); }

  @media (min-width: 1024px) {
    .ptest__cards { grid-template-columns: repeat(3, 1fr); align-items: start; }
    .ptest__slot:nth-child(2) { margin-block-start: var(--space-8); }
    .ptest__slot:nth-child(3) { margin-block-start: var(--space-4); }
  }
</style>
