---
/**
 * Home §1.7 «توضيح أن الموافقة ليست مضمونة» — the important notice, whole (brief part 04).
 * A legal notice: deliberately calm. NEVER animated, never hidden, no scene, no data-reveal — always plainly readable.
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  ar: { label: 'تنبيه مهم:', text: 'قرار منح التأشيرة أو رفضها يعود حصريًا إلى السفارة أو القنصلية أو الجهة الرسمية المختصة. خدمات WaysZ Visa استشارية وإرشادية فقط، ولا نضمن الموافقة على أي طلب، ولا نملك أي تأثير على قرار الجهة المختصة.' },
  en: { label: 'Important notice:', text: 'The decision to grant or refuse a visa rests solely with the embassy, consulate or competent official authority. WaysZ Visa services are advisory and guidance only; we do not guarantee the approval of any application, and we have no influence over the competent authority’s decision.' },
}[lang];
---
<section class="pnotice" aria-label={copy.label.replace(':', '')}>
  <div class="container">
    <p class="pnotice__card"><strong>{copy.label}</strong>{' '}{copy.text}</p>
  </div>
</section>

<style>
  .pnotice { background: var(--color-bg-alt); padding-block: 0 var(--section-y); }
  .pnotice__card {
    max-width: 60rem; margin-inline: auto; padding: var(--space-6) var(--space-6);
    background: var(--color-surface); border: 1px solid var(--color-border); border-inline-start: 4px solid var(--color-error);
    border-radius: var(--radius-md); font-size: var(--text-lg); line-height: 1.9; color: var(--color-ink);
  }
  .pnotice__card strong { color: var(--color-error); font-weight: var(--weight-bold); }
</style>
