---
/**
 * Contact Us. Skeleton (no design yet). Intro = brief part 03 (WaysZ) §5 intro adapted to WaysZ Visa.
 * Contact items (§5.1–5.4) and quick buttons (part 05) come ONLY from src/lib/site.ts: an empty value is not rendered
 * (TODO(client): all empty for now, so only the placeholders show). Visa requests go to /consultation/ — no form here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoSection from '../components/TodoSection.astro';
import { site, telHref, waHref } from '../lib/site';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  ar: {
    title: 'تواصل معنا',
    lead: 'يسعدنا تواصلك. أخبرنا باستفسارك، وسيتواصل معك فريق WaysZ Visa في أقرب وقت ممكن.',
    phone: 'الهاتف', email: 'البريد الإلكتروني', whatsapp: 'واتساب',
    cardTitle: 'لديك طلب تأشيرة؟',
    cardText: 'لطلبات التأشيرة، املأ نموذج طلب الاستشارة بتفاصيل سفرك، وسيتواصل معك أحد مستشارينا لتحديد الخطوات المناسبة لحالتك.',
  },
  en: {
    title: 'Contact us',
    lead: 'We’re glad to hear from you. Tell us your question, and the WaysZ Visa team will contact you as soon as possible.',
    phone: 'Phone', email: 'Email', whatsapp: 'WhatsApp',
    cardTitle: 'Have a visa request?',
    cardText: 'For visa requests, fill in the consultation request form with the details of your trip, and one of our consultants will contact you to set the right next steps for your case.',
  },
}[lang];

// §5.2 phone · §5.3 email · §5.4 WhatsApp — rendered only when site.ts has a value
const phone: string = site.phone, email: string = site.email, whatsapp: string = site.whatsapp;
const items = [
  { label: copy.phone, value: phone, href: telHref(phone) },
  { label: copy.email, value: email, href: `mailto:${email}` },
  { label: copy.whatsapp, value: whatsapp, href: waHref(whatsapp, t.whatsapp.message) },
].filter((i) => i.value);
// part 05: «اتصل بنا» — «راسلنا على واتساب» — «أرسل بريدًا إلكترونيًا»
const buttons = [
  { label: t.cta.call, value: phone, href: telHref(phone), cls: 'btn--accent' },
  { label: t.cta.whatsapp, value: whatsapp, href: waHref(whatsapp, t.whatsapp.message), cls: 'btn--dark' },
  { label: t.cta.email, value: email, href: `mailto:${email}`, cls: 'btn--ghost' },
].filter((b) => b.value);
---
<BaseLayout lang={lang} title={t.pages.contact.title} description={t.pages.contact.description}>
  <header class="intro container stack">
    <h1>{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
  </header>

  <TodoSection ref="5.1" title="بيانات التواصل — الهاتف · البريد الإلكتروني · واتساب (src/lib/site.ts)">
    {items.length > 0 && (
      <dl class="items">
        {items.map((i) => (
          <div><dt>{i.label}</dt><dd><a href={i.href} dir="ltr"><bdi>{i.value}</bdi></a></dd></div>
        ))}
      </dl>
    )}
  </TodoSection>

  <TodoSection ref="5.6" title="أزرار الاتصال السريع — اتصل بنا · راسلنا على واتساب · أرسل بريدًا إلكترونيًا">
    {buttons.length > 0 && (
      <p class="actions">
        {buttons.map((b) => <a class:list={['btn', b.cls]} href={b.href} rel="noopener" data-magnetic>{b.label}</a>)}
      </p>
    )}
  </TodoSection>

  <TodoSection ref="contact.card" title="بطاقة طلب الاستشارة → /consultation/">
    <h2>{copy.cardTitle}</h2>
    <p>{copy.cardText}</p>
    <p><a class="btn btn--accent" href={localizePath('/consultation/', lang)} data-magnetic>{t.cta.request}</a></p>
  </TodoSection>
</BaseLayout>

<style>
  .intro { padding-block: 160px var(--space-6); }
  .items { display: grid; gap: var(--space-3); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); }
</style>
