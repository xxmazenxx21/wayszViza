---
/**
 * «اعرف تأشيرتك» — the preliminary assessment tool (brief v3 §11). One question per card, in the paper world of the Home
 * finder (§1.5d): a stack of paper question cards on the navy night; the answered card turns over its top edge and
 * leaves, the next one rises from the stack; at the end the suggestion settles on top. Q1 purpose → Q1b (investment only)
 * → Q1c destination (the category's countries, brief v3 §7b = the visa JSON) → Q2 (worded by Q1) → Q3 refusal → Q4 when
 * → Q5 alone / family / team → the result: the suggested category (+ its page), its destinations (the chosen one marked),
 * the suggested services (§11 rules, src/lib/assessment.ts), the line under the result and «أكمل طلب الاستشارة» →
 * /consultation/ prefilled. Runs fully in the browser and sends nothing.
 * Scene: motion/scenes/paper-assess.ts (builds the cards from the data below; real buttons, focus moves to each new
 * question heading). DOM + GSAP, no WebGL.
 * No JS: a readable static version — the nine categories by group with links + a link to the consultation.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { assessmentCopy } from '../data/assessment';
import { countries } from '../lib/countries';
import { visaGroups } from '../content.config';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  ar: {
    title: 'اعرف تأشيرتك المناسبة',
    lead: 'أسئلة قصيرة لا تستغرق دقيقة، ونرشح لك نوع التأشيرة الأقرب لحالتك والخدمات التي قد تحتاجها.',
  },
  en: {
    title: 'Find the right visa for you',
    lead: 'A few short questions, under a minute, and we’ll suggest the visa type closest to your situation, its destinations and the services you may need.',
  },
}[lang];

const visas = (await getCollection('visas')).sort((a, b) => a.data.order - b.data.order);
const page = (slug: string) => localizePath(`/visa-services/${slug}/`, lang);
const consult = localizePath('/consultation/', lang);

const categories = Object.fromEntries(visas.flatMap((e) => (e.data.kind === 'category' ? [[e.id, {
  name: e.data[lang].name,
  group: t.nav.groups[e.data.group],
  text: e.data[lang].summary?.text ?? e.data[lang].description,
  fit: e.data[lang].summary?.fit,
  href: page(e.id),
  legs: (e.data[lang].destinations ?? []).map((l) => ({ label: l.label, countries: countries(l.countries, lang) })),
}]] : [])));
const services = Object.fromEntries(visas.flatMap((e) => (e.data.kind === 'service' ? [[e.id, {
  name: e.data[lang].name, short: e.data[lang].short ?? '', href: page(e.id),
}]] : [])));

// everything the tool needs, in the page's language
const data = {
  ui: { ...t.assessment, suits: t.visa.suits },
  copy: assessmentCopy(lang),
  consult,
  categories,
  services,
};

// the no-JS version: the categories by group
const groups = visaGroups.map((g) => ({
  label: t.nav.groups[g],
  items: visas.filter((e) => e.data.kind === 'category' && e.data.group === g),
}));
const arrow = 'M5 12h14m-6-6 6 6-6 6';
---
<BaseLayout lang={lang} title={t.pages.assessment.title} description={t.pages.assessment.description} headerOverlay>
  <section class="afind theme-dark" data-scene="paper-assess" data-assess={JSON.stringify(data)} aria-labelledby="afind-title">
    <div class="afind__glow" aria-hidden="true"></div>
    <div class="container afind__in">
      <header class="afind__head">
        <h1 class="afind__title" id="afind-title">{copy.title}</h1>
        <p class="afind__lead">{copy.lead}</p>
      </header>

      <!-- the tool (JS): a deck of paper cards; the scene deals the questions onto it -->
      <div class="afind__tool">
        <div class="afind__deck">
          <div class="afind__sheet afind__sheet--2" aria-hidden="true"></div>
          <div class="afind__sheet afind__sheet--1" aria-hidden="true"></div>
          <article class="afind__card afind__card--cover theme-light">
            <p class="afind__dots" aria-hidden="true">{Array.from({ length: 6 }, () => <span></span>)}</p>
            <p class="afind__cover">{t.assessment.cover}</p>
            <div class="afind__cover-actions">
              <button type="button" class="btn btn--accent afind__start" data-start>
                {t.assessment.start}
                <svg class="icon-dir" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={arrow} /></svg>
              </button>
              <a class="afind__skip" href={consult}>{t.assessment.skip}</a>
            </div>
            <p class="afind__private">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 10V8a6 6 0 0 1 12 0v2M5 10h14v10H5zM12 14v2.5" /></svg>
              {t.assessment.private}
            </p>
          </article>
        </div>
      </div>

      <!-- without JS: the categories with links + the consultation -->
      <div class="afind__static theme-light">
        <p class="afind__static-text">{t.assessment.static}</p>
        <h2 class="afind__static-title">{t.nav.categories}</h2>
        {groups.map((g) => (
          <div class="afind__static-group">
            <h3>{g.label}</h3>
            <ul role="list">
              {g.items.map((e) => (
                <li>
                  <a href={page(e.id)}>{e.data[lang].name}</a>
                  {e.data[lang].summary && <p>{e.data[lang].summary.text}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p><a class="btn btn--accent" href={consult}>{t.cta.request}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .afind { position: relative; overflow: clip; min-height: 100svh; padding-block: clamp(7.5rem, 6rem + 5vw, 10rem) var(--section-y); }
  .afind__glow {
    position: absolute; inset: auto -25% -30% auto; width: 80vmax; height: 80vmax; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent);
  }
  :global([dir='rtl']) .afind__glow { inset: auto auto -30% -25%; }
  .afind__in { position: relative; display: grid; gap: clamp(2.5rem, 1.5rem + 4vw, 4rem); }
  .afind__title { font-size: clamp(2.2rem, 1.3rem + 3.6vw, 4.2rem); line-height: 1.2; }
  :global([dir='rtl']) .afind__title { line-height: 1.4; }
  /* small screens: the title takes two lines in Almarai but may fit one in the fallback font — reserve two, so the
     deck under it does not jump when the font swaps in (layout shift) */
  @media (max-width: 1023px) { .afind__title { min-height: 2lh; } }
  .afind__lead { margin-block-start: var(--space-4); max-width: 44ch; font-size: var(--text-lg); line-height: 1.85; color: color-mix(in srgb, var(--color-ink) 86%, transparent); }

  /* the deck: every card in the same cell, two blank sheets under it */
  .afind__deck { position: relative; display: grid; width: min(100%, 40rem); justify-self: center; perspective: 1400px; }
  .afind__sheet, .afind__deck :global(.afind__card) { grid-area: 1 / 1; border-radius: var(--radius-lg); }
  .afind__sheet { background: color-mix(in srgb, var(--color-surface) 70%, var(--color-ink)); opacity: 0.32; }
  .afind__sheet--1 { rotate: 2deg; translate: 0 10px; }
  .afind__sheet--2 { rotate: -3deg; translate: 0 20px; opacity: 0.18; }

  .afind__deck :global(.afind__card) {
    position: relative; display: grid; align-content: start; gap: var(--space-5);
    min-height: 24rem; padding: clamp(1.25rem, 0.6rem + 3vw, 2.75rem);
    background:
      radial-gradient(120% 60% at 0% 0%, color-mix(in srgb, var(--color-bg-alt) 55%, transparent), transparent 60%),
      var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 34px 70px -26px color-mix(in srgb, black 82%, transparent);
    transform-origin: 50% 0;
  }
  .afind__deck :global(.afind__dots) { display: flex; flex-wrap: wrap; gap: 6px; }
  .afind__deck :global(.afind__dots span) { width: 24px; height: 4px; border-radius: 2px; background: color-mix(in srgb, var(--color-ink) 14%, transparent); }
  .afind__deck :global(.afind__dots span.is-on) { background: var(--color-accent-strong); }

  /* cover */
  .afind__card--cover { align-content: center !important; }
  .afind__cover { font-size: var(--text-2xl); font-weight: var(--weight-bold); line-height: 1.4; max-width: 18ch; }
  .afind__cover-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5); }
  .afind__start { min-height: 56px; padding-inline: var(--space-7); font-size: var(--text-base); }
  .afind__start svg, .afind__private svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .afind__skip { color: var(--color-link); font-weight: var(--weight-bold); font-size: var(--text-sm); line-height: 1.6; padding-block: var(--space-3); }
  .afind__private { display: flex; gap: var(--space-2); align-items: flex-start; color: var(--color-ink-muted); font-size: var(--text-sm); line-height: 1.7; }
  .afind__private svg { flex: none; margin-block-start: 3px; }

  /* question cards (built by the scene) */
  .afind__deck :global(.afind__top) { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .afind__deck :global(.afind__count) { color: var(--color-ink-muted); font-size: var(--text-sm); white-space: nowrap; }
  .afind__deck :global(.afind__q) { font-size: var(--text-xl); line-height: 1.5; outline: none; }
  .afind__deck :global(.afind__opts) { display: grid; gap: var(--space-3); }
  .afind__deck :global(.afind__opt) {
    display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: 54px; padding: var(--space-2) var(--space-5);
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent); border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-bg-alt) 45%, var(--color-surface)); color: var(--color-ink);
    font: inherit; font-size: var(--text-base); line-height: 1.5; text-align: start; cursor: pointer;
    transition: background-color 0.3s var(--ease-out), border-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  @media (hover: hover) {
  .afind__deck :global(.afind__opt:hover) { border-color: var(--color-accent-strong); }
  }
  .afind__deck :global(.afind__opt svg) {
    flex: none; width: 20px; height: 20px; padding: 2px; border-radius: 50%; fill: none; stroke: transparent; stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--color-ink) 30%, transparent);
    transition: stroke 0.3s var(--ease-out);
  }
  .afind__deck :global(.afind__opt[aria-pressed='true']) { background: var(--color-accent-strong); border-color: var(--color-accent-strong); color: var(--color-on-accent); }
  .afind__deck :global(.afind__opt[aria-pressed='true'] svg) { stroke: currentColor; box-shadow: inset 0 0 0 1.5px currentColor; }
  /* countries: compact chips · the last choice («ليس بعد») on its own line */
  .afind__deck :global(.afind__opts--chips) { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .afind__deck :global(.afind__opts--chips .afind__opt) { width: auto; min-height: 46px; padding-inline: var(--space-4); font-size: var(--text-sm); }
  .afind__deck :global(.afind__opt--none) { flex-basis: 100%; }
  .afind__deck :global(.afind__leg) { flex-basis: 100%; margin-block-start: var(--space-2); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .afind__deck :global(.afind__leg:first-child) { margin-block-start: 0; }
  @media (min-width: 640px) {
    .afind__deck :global(.afind__opts--grid) { grid-template-columns: 1fr 1fr; }
  }

  .afind__deck :global(.afind__nav) {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4);
    margin-block-start: var(--space-2); padding-block-start: var(--space-4); border-block-start: 1px dashed var(--color-border);
  }
  .afind__deck :global(.afind__navbtn) {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding-inline: var(--space-2);
    border: 0; background: none; color: var(--color-ink); font: inherit; font-size: var(--text-sm); font-weight: var(--weight-bold); cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .afind__deck :global(.afind__navbtn:hover) { color: var(--color-accent-ink); }
  .afind__deck :global(.afind__navbtn svg) { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .afind__deck :global(.afind__navbtn--restart) { margin-inline-start: auto; color: var(--color-ink-muted); }

  /* the result */
  .afind__deck :global(.afind__card--result) {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 40%, transparent), 0 34px 80px -24px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .afind__deck :global(.afind__rtitle) { display: grid; gap: var(--space-2); outline: none; }
  .afind__deck :global(.afind__rlabel) { font-size: var(--text-base); font-weight: var(--weight-regular); color: var(--color-ink-muted); line-height: 1.6; }
  .afind__deck :global(.afind__rname) { font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem); line-height: 1.3; color: var(--color-accent-ink); }
  .afind__deck :global(.afind__group) {
    justify-self: start; padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent-ink); font-size: var(--text-xs); font-weight: var(--weight-bold);
  }
  .afind__deck :global(.afind__rtext) { line-height: 1.85; }
  .afind__deck :global(.afind__fit) { color: var(--color-ink-muted); font-size: var(--text-sm); line-height: 1.7; }
  .afind__deck :global(.afind__fit strong) { color: var(--color-ink); }
  .afind__deck :global(.afind__alt) {
    display: grid; gap: var(--space-2); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 55%, transparent); background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
  }
  .afind__deck :global(.afind__alt-label) { font-size: var(--text-xs); font-weight: var(--weight-bold); color: var(--color-accent-ink); }
  .afind__deck :global(.afind__alt-name) { font-size: var(--text-lg); font-weight: var(--weight-bold); }
  .afind__deck :global(.afind__block) { display: grid; gap: var(--space-3); padding-block-start: var(--space-4); border-block-start: 1px solid var(--color-border); }
  .afind__deck :global(.afind__block h3) { font-size: var(--text-base); }
  .afind__deck :global(.afind__dest) { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .afind__deck :global(.afind__dest a) {
    display: inline-flex; align-items: center; min-height: 40px; padding-inline: var(--space-4); border-radius: var(--radius-pill);
    border: 1px solid var(--color-border); text-decoration: none; font-size: var(--text-sm);
    transition: border-color 0.3s var(--ease-out), background-color 0.3s var(--ease-out);
  }
  @media (hover: hover) {
  .afind__deck :global(.afind__dest a:hover) { border-color: var(--color-accent-strong); }
  }
  .afind__deck :global(.afind__dest a.is-chosen) { background: var(--color-accent-strong); border-color: var(--color-accent-strong); color: var(--color-on-accent); font-weight: var(--weight-bold); }
  .afind__deck :global(.afind__svcs) { display: grid; gap: var(--space-2); }
  .afind__deck :global(.afind__svcs a) {
    display: grid; gap: 2px; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-alt) 55%, var(--color-surface)); text-decoration: none;
    transition: background-color 0.3s var(--ease-out);
  }
  .afind__deck :global(.afind__svcs a:hover) { background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface)); }
  .afind__deck :global(.afind__svcs strong) { font-size: var(--text-sm); }
  .afind__deck :global(.afind__svcs span) { font-size: var(--text-sm); color: var(--color-ink-muted); line-height: 1.7; }
  .afind__deck :global(.afind__route) { width: 11rem; height: 2rem; justify-self: center; fill: none; stroke: color-mix(in srgb, var(--color-accent) 60%, transparent); stroke-width: 1.6; stroke-dasharray: 2 5; stroke-linecap: round; }
  .afind__deck :global(.afind__route .afind__plane) { fill: var(--color-accent); stroke: none; }
  :global([dir='rtl']) .afind__deck :global(.afind__route) { scale: -1 1; }
  .afind__deck :global(.afind__line) { color: var(--color-ink-muted); font-size: var(--text-sm); line-height: 1.8; text-align: center; }
  .afind__deck :global(.link-arrow svg), .afind__deck :global(.afind__go svg) { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .afind__deck :global(.link-arrow) { justify-self: start; color: var(--color-link); font-weight: var(--weight-bold); font-size: var(--text-sm); }
  .afind__deck :global(.afind__go) { justify-self: center; min-height: 56px; padding-inline: var(--space-7); font-size: var(--text-base); white-space: normal; text-align: center; }

  /* the static version (no JS) */
  .afind__static {
    display: grid; gap: var(--space-5); padding: clamp(1.25rem, 0.6rem + 3vw, 2.75rem); border-radius: var(--radius-lg);
    background: var(--color-surface); color: var(--color-ink);
  }
  .afind__static-text { font-size: var(--text-lg); line-height: 1.8; }
  .afind__static-title { font-size: var(--text-xl); }
  .afind__static-group h3 { font-size: var(--text-base); color: var(--color-accent-ink); margin-block-end: var(--space-2); }
  .afind__static-group ul { display: grid; gap: var(--space-3); }
  .afind__static-group a { font-weight: var(--weight-bold); color: var(--color-link); }
  .afind__static-group p { color: var(--color-ink-muted); font-size: var(--text-sm); line-height: 1.7; }
  :global(html:not(.js)) .afind__tool { display: none; }
  :global(.js) .afind__static { display: none; }

  @media (min-width: 1024px) {
    .afind__in { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: start; }
    .afind__head { position: sticky; top: 9rem; }
    .afind__deck { justify-self: end; }
  }
</style>
