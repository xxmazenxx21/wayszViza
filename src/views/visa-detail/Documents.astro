---
/**
 * Visa Service Details — 5 «المستندات والمعلومات المطلوبة مبدئيًا» + the note (brief v3 §6). Scene: atlas-docs.
 * The list is a checklist on a light sheet (a theme-light island) that ticks itself off with the scroll; when the list
 * ends the only seal of the page lands once: «ملف جاهز» / "File ready" (the Home's seal — never an "approved" stamp).
 * No JS: every item ticked, the seal shown.
 */
import { useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; items: string[]; note: string }
const { lang, items, note } = Astro.props;
const t = useTranslations(lang);
---
<section class="adocs section theme-dark" data-scene="atlas-docs" data-waypoint aria-labelledby="adocs-title">
  <div class="container adocs__in">
    <div class="adocs__side">
      <h2 class="adocs__title" id="adocs-title">{t.visa.documents}</h2>
      <p class="adocs__note">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5.5M12 7.6v.2" /></svg>
        <span>{note}</span>
      </p>
    </div>
    <div class="adocs__sheet theme-light">
      <div class="adocs__sheet-in">
        <ul class="adocs__list" role="list">
          {items.map((x) => (
            <li class="adoc">
              <svg class="adoc__box" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                <path class="adoc__check" d="M7 12.4l3.3 3.3L17.2 8.6" pathLength="1" />
              </svg>
              <span class="adoc__text">{x}</span>
            </li>
          ))}
        </ul>
        <svg class="adocs__seal" viewBox="0 0 160 160" aria-hidden="true">
          <circle cx="80" cy="80" r="74" /><circle cx="80" cy="80" r="66" stroke-dasharray="2 5" />
          <path class="adocs__seal-check" d="M58 64l14 14 30-30" />
          <text x="80" y="118" text-anchor="middle">{t.visa.fileReady}</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .adocs { position: relative; overflow: clip; background: var(--color-bg-alt); }
  .adocs__in { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 1024px) { .adocs__in { grid-template-columns: 5fr 7fr; align-items: center; } }
  .adocs__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.4rem); line-height: 1.3; max-width: 16ch; }
  .adocs__note { display: flex; gap: var(--space-3); margin-block-start: var(--space-5); max-width: 40ch; color: var(--color-ink-muted); line-height: 1.8; }
  .adocs__note svg { flex: none; margin-block-start: 0.3em; fill: none; stroke: var(--color-link); stroke-width: 1.8; stroke-linecap: round; }

  /* the sheet: paper on the night, a soft shadow, a little turned until it lands */
  .adocs__sheet { position: relative; border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-ink); box-shadow: 0 40px 90px color-mix(in srgb, var(--color-ink) 55%, transparent); }   /* ink = the navy inside this light island */
  .adocs__sheet-in { position: relative; padding: var(--space-7) var(--space-6); }
  .adocs__list { display: grid; gap: 0; }
  .adoc { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: start; padding-block: var(--space-4); border-block-end: 1px solid var(--color-border); }
  .adoc:last-child { border-block-end: 0; }
  .adoc__box { flex: none; margin-block-start: 0.15em; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .adoc__box rect { stroke: color-mix(in srgb, var(--color-ink) 30%, transparent); stroke-width: 1.5; transition: stroke 0.4s var(--ease-out), fill 0.4s var(--ease-out); }
  .adoc__check { stroke: var(--color-on-accent); stroke-width: 2.4; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .adoc__text { font-size: var(--text-lg); line-height: 1.7; }
  :global(.js) .adoc__check { stroke-dashoffset: 1; transition: stroke-dashoffset 0.45s var(--ease-out) 0.08s; }
  :global(.js) .adoc__box rect { fill: transparent; }
  .adoc:global(.is-done) .adoc__check, :global(html:not(.js)) .adoc__check { stroke-dashoffset: 0; }
  .adoc:global(.is-done) .adoc__box rect, :global(html:not(.js)) .adoc__box rect { fill: var(--color-accent-strong); stroke: var(--color-accent-strong); }
  .adoc__text { transition: color 0.4s var(--ease-out); }

  .adocs__seal {
    position: absolute; inset-block-end: calc(-1 * var(--space-6)); inset-inline-end: calc(-1 * var(--space-4));
    width: clamp(6.5rem, 4rem + 7vw, 9.5rem); overflow: visible; fill: none; stroke: var(--color-accent-strong); stroke-width: 3;
    rotate: -10deg; filter: drop-shadow(0 6px 16px color-mix(in srgb, var(--color-bg) 30%, transparent));
  }
  .adocs__seal-check { stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .adocs__seal text { fill: var(--color-accent-strong); stroke: none; font: var(--weight-bold) 19px var(--font-display); }
  @media (max-width: 639px) {
    .adocs__sheet-in { padding: var(--space-5) var(--space-5) var(--space-8); }
    .adoc__text { font-size: var(--text-base); }
    .adocs__seal { inset-block-end: calc(-1 * var(--space-5)); inset-inline-end: var(--space-2); }
  }
</style>
