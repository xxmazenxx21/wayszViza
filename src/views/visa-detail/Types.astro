---
/**
 * Visa Service Details — 2b «أنواع شائعة» (optional, brief v3 §6). Scene: atlas-rise (`data-rise="stage"`).
 * Large frosted cards over the night Earth, which rises behind them like a horizon (act `atlas`, shot "types"). With the
 * scroll each card comes out of depth a little later than the one before — staged, then aligned. Not a sequence: no
 * numbers. A card with a title (the investment page) shows it; the others are one large line each.
 */
import { useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; items: { title?: string; text: string }[] }
const { lang, items } = Astro.props;
const t = useTranslations(lang);
const titled = items.some((x) => x.title);
---
<section class:list={['atypes', { 'atypes--titled': titled }]} data-scene="atlas-rise" data-rise="stage" data-shot="types" data-waypoint aria-labelledby="atypes-title">
  <div class="container atypes__in">
    <h2 class="atypes__title" id="atypes-title" data-rise-title>{t.visa.types}</h2>
    <ul class="atypes__list" role="list" style={`--cols: ${Math.min(items.length, 4)}`}>
      {items.map((x) => (
        <li class="atype" data-rise-item>
          <span class="atype__glint" aria-hidden="true"></span>
          {x.title && <h3 class="atype__name">{x.title}</h3>}
          <p class="atype__text">{x.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .atypes { position: relative; display: grid; align-items: center; min-height: 100vh; min-height: 100lvh; padding-block: var(--section-y); }
  .atypes__title { font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1.25; }
  .atypes__list { display: grid; gap: var(--space-5); margin-block-start: var(--space-7); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .atypes__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .atypes__list { grid-template-columns: repeat(var(--cols), 1fr); gap: var(--space-6); } }
  .atype {
    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-3);
    min-height: clamp(11rem, 8rem + 10vw, 17rem); padding: var(--space-6); border-radius: var(--radius-lg);
    background: linear-gradient(165deg, color-mix(in srgb, var(--color-surface) 62%, transparent), color-mix(in srgb, var(--color-bg) 86%, transparent));
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 12%, transparent), 0 30px 70px color-mix(in srgb, var(--color-bg) 65%, transparent);
  }
  /* a line of light along the top edge of the glass, like the routes of the map */
  .atype__glint {
    position: absolute; inset: 0 0 auto; height: 2px;
    background: linear-gradient(to right, transparent, color-mix(in srgb, var(--color-accent) 80%, transparent), transparent);
  }
  .atype__text { font-size: var(--text-xl); line-height: 1.5; font-weight: var(--weight-bold); }
  :global([dir='rtl']) .atype__text { line-height: 1.7; }
  .atypes--titled .atype__name { font-size: var(--text-xl); line-height: 1.4; }
  .atypes--titled .atype__text { font-size: var(--text-base); font-weight: var(--weight-regular); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 86%, transparent); }
  @media (max-width: 639px) { .atype { padding: var(--space-5); min-height: 7rem; } .atype__text { font-size: var(--text-lg); } }
</style>
