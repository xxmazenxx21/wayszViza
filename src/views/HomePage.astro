---
/**
 * Home (brief part 01 «ثانيًا: موقع WaysZ Visa» §1 · copy: part 04 §1). Skeleton: the hero carries its copy,
 * every other section is a <TodoSection> in the brief's order — replace one at a time.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoSection from '../components/TodoSection.astro';
import { site } from '../lib/site';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Hero (part 04 §1). Alternative title in the brief: «ملف مكتمل.. وخطوات واضحة.. واستعداد أفضل لموعدك»
const copy = {
  ar: {
    title: 'طريقك إلى التأشيرة يبدأ بخطوة صحيحة',
    lead: 'سواء كنت تسافر للدراسة أو العمل أو الإقامة أو لزيارة عائلتك، نقدم لك استشارات متخصصة وإرشادًا عمليًا يساعدك على فهم متطلبات التأشيرة، وتجهيز ملفك، والاستعداد لموعدك بثقة.',
  },
  en: {
    title: 'Your path to a visa starts with the right step',
    lead: 'Whether you are traveling to study, work, live abroad or visit your family, we offer specialized consultations and practical guidance to help you understand the visa requirements, prepare your file and get ready for your appointment with confidence.',
  },
}[lang];
---
<BaseLayout lang={lang} title={t.pages.home.title} description={t.pages.home.description} preloader headerOverlay>
  <!-- Hero (part 04 §1): main title, subtitle, two buttons -->
  <section class="hero theme-dark">
    <div class="container hero__inner stack">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--accent" href={localizePath('/consultation/', lang)} data-magnetic>{t.cta.start}</a>
        <a class="btn btn--ghost" href={localizePath('/visa-services/', lang)}>{t.cta.explore}</a>
      </div>
    </div>
  </section>

  <TodoSection ref="1.1" title="تعريف بخدمات التأشيرات — «كيف نساعدك في رحلة التأشيرة؟»" />
  <TodoSection ref="1.2" title="استشارة التأشيرة — Visa Consultation" />
  <TodoSection ref="1.3" title="جاهزية المستندات — Document Readiness" />
  <TodoSection ref="1.4" title="الإرشاد في الطلب — Application Guidance" />
  <TodoSection ref="1.5" title="الاستعداد للموعد — Appointment Preparation" />
  <TodoSection ref="1.6" title="خطوات المساعدة — «خطوات بسيطة نحو ملف جاهز»" />
  <TodoSection ref="1.7" title="توضيح أن الموافقة ليست مضمونة" />
  <TodoSection ref="1.8" title="زر بدء الاستشارة">
    <p><a class="btn btn--accent" href={localizePath('/consultation/', lang)}>{t.cta.start}</a></p>
  </TodoSection>
  <TodoSection ref="1.9" title="رابط WaysZ الرئيسي — «جزء من WaysZ»">
    <p><a class="btn btn--dark" href={site.mainSite} rel="noopener">{t.cta.visitMain}</a></p>
  </TodoSection>
</BaseLayout>

<style>
  .hero { min-height: 100svh; display: grid; align-items: center; padding-block: 120px var(--space-8); }
  .hero h1 { font-size: var(--text-hero); max-width: 18ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-block-start: var(--space-4); }
</style>
