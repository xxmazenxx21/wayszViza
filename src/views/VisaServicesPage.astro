---
/**
 * Visa Services (brief part 01 «ثانيًا» §2 · copy: part 04 §2). Skeleton: intro + one <TodoSection> per section.
 * A category card links to /visa-services/<slug>/ only when src/content/visas/<slug>.json exists;
 * otherwise it points to the consultation page.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TodoSection from '../components/TodoSection.astro';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  ar: {
    title: 'خدمات التأشيرات',
    lead: 'سواء كنت تسافر للدراسة أو العمل أو حضور مؤتمر، أو لزيارة عائلتك أو الإقامة بالخارج، نساعدك على فهم متطلبات تأشيرتك وتجهيز ملفك خطوة بخطوة.',
    unsure: 'لست متأكدًا من نوع تأشيرتك؟',
    categories: {
      student: 'تأشيرة الدراسة',
      business: 'تأشيرة الأعمال والمؤتمرات',
      immigration: 'تأشيرة الهجرة والإقامة',
      family: 'التأشيرة العائلية',
      tourist: 'تأشيرة الزيارة القصيرة',
    },
  },
  en: {
    title: 'Visa services',
    lead: 'Whether you are traveling to study, work or attend a conference, or to visit your family or live abroad, we help you understand your visa requirements and prepare your file step by step.',
    unsure: 'Not sure which visa you need?',
    categories: {
      student: 'Student Visa',
      business: 'Business & Conference Visa',
      immigration: 'Immigration & Residence Visa',
      family: 'Family Visa',
      tourist: 'Tourist Visa',
    },
  },
}[lang];

// §2.2 the five categories, in the brief's order, and the slug their detail page would have
const CATEGORIES = [
  { key: 'student', slug: 'student-visa' },
  { key: 'business', slug: 'business-visa' },
  { key: 'immigration', slug: 'immigration-residence-visa' },
  { key: 'family', slug: 'family-visa' },
  { key: 'tourist', slug: 'tourist-visa' },
] as const;
const pages = new Set((await getCollection('visas')).map((v) => v.id));
const consult = localizePath('/consultation/', lang);
const categories = CATEGORIES.map((c) => ({
  label: copy.categories[c.key],
  href: pages.has(c.slug) ? localizePath(`/visa-services/${c.slug}/`, lang) : consult,
}));
---
<BaseLayout lang={lang} title={t.pages.visaServices.title} description={t.pages.visaServices.description}>
  <header class="intro container stack">
    <h1>{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
  </header>

  <TodoSection ref="2.1" title="عرض خدمات التأشيرات — استشارة التأشيرة · جاهزية المستندات · الإرشاد في تعبئة الطلب · الاستعداد للموعد" />
  <TodoSection ref="2.2" title="فئات التأشيرات (2.3 وصف مختصر لكل فئة) + «لست متأكدًا من نوع تأشيرتك؟»">
    <ul role="list">
      {categories.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      <li>{copy.unsure}{" "}<a href={consult}>{t.cta.request}</a></li>
    </ul>
  </TodoSection>
  <TodoSection ref="2.4" title="زر طلب الاستشارة — «جاهز لتحديد طريقك؟»">
    <p><a class="btn btn--accent" href={consult}>{t.cta.request}</a></p>
  </TodoSection>
</BaseLayout>

<style>
  .intro { padding-block: 160px var(--space-6); }
</style>
