---
/**
 * Visa Services — «رحلة في المطار» / "Through the Terminal" (docs/visa-services-creative-treatment.md).
 * Copy and order (brief v3 §5): title + intro (v2) · §2.1 the nine services (§3 order: the four core first, then the
 * five new) · §2.2 + §2.3 the nine categories in their four groups (§2, §16 labels) with the §7 line and «تناسب:» ·
 * «لست متأكدًا من نوع تأشيرتك؟» → /assessment/ · FAQ (§19.2) · §2.4 (v2). Names and lines come from
 * src/content/visas/*.json (`name`, `short`, `summary`); every card links to its detail page (one template).
 *
 * ONE film layer (`.tt__film`, CSS sticky) behind hero → §2.1 → §2.2: real footage scrubbed by the scroll (scene
 * airport-thread, act `airport` in the stage host; a 2D canvas on the css tier) at full quality. The sections scroll
 * over it; every word is DOM, on a local scrim or an opaque card. §2.4 has its own host (the takeoff, scene airport-cta). No JS: the first frame of each
 * chapter as a still behind its section.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './visa-services/Hero.astro';
import Rests, { type RestCard, type RestSign } from './visa-services/Rests.astro';
import Faq from './visa-services/Faq.astro';
import Cta from './visa-services/Cta.astro';
import { visaGroups } from '../content.config';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const visas = (await getCollection('visas')).sort((a, b) => a.data.order - b.data.order);
const href = (slug: string) => localizePath(`/visa-services/${slug}/`, lang);
const alt = (d: (typeof visas)[number]['data']) => ({ text: d[other].name, lang: other });

// §2.1 — the nine services in the order of §3 (the four core ones are 1–4)
const services: RestCard[] = visas.filter((v) => v.data.kind === 'service').map((v) => ({
  name: v.data[lang].name, alt: alt(v.data), text: v.data[lang].short ?? '', href: href(v.id),
}));

// §2.2 + §2.3 — the nine categories at their gates: zone A–D = the four groups of §2 (gate codes are DOM, never footage)
const LETTERS = ['A', 'B', 'C', 'D'];
const signs: RestSign[] = visaGroups.map((g, z) => ({ zone: z, letter: LETTERS[z], label: t.nav.groups[g] }));
const perZone = [0, 0, 0, 0];
const categories: RestCard[] = visas.flatMap((v) => {
  if (v.data.kind !== 'category') return [];
  const z = visaGroups.indexOf(v.data.group);
  const d = v.data[lang];
  return [{
    zone: z, gate: `${LETTERS[z]}${++perZone[z]}`, group: t.nav.groups[v.data.group],
    name: d.name, alt: alt(v.data), text: d.summary?.text ?? '', fit: d.summary?.fit, href: href(v.id),
  }];
});
// the last card (brief v3 §5 2.2): the assessment tool «اعرف تأشيرتك»
const unsure = {
  ar: { name: 'لست متأكدًا من نوع تأشيرتك؟', text: 'أجب عن أسئلة قصيرة في أقل من دقيقة، ونرشح لك نوع التأشيرة الأقرب لحالتك.' },
  en: { name: 'Not sure which visa you need?', text: 'Answer a few short questions in under a minute and we’ll suggest the visa type closest to your situation.' },
}[lang];
categories.push({ name: unsure.name, text: unsure.text, href: localizePath('/assessment/', lang), link: t.nav.findVisa, unsure: true });
---
<BaseLayout lang={lang} title={t.pages.visaServices.title} description={t.pages.visaServices.description} headerOverlay>
  <div class="tt theme-dark">
    <div class="tt__film" aria-hidden="true">
      <picture class="tt__still">
        <source media="(max-width: 1023px)" srcset="/media/video/airport-approach-poster-m.webp" width="816" height="1440" />
        <img src="/media/video/airport-approach-poster.webp" srcset="/media/video/airport-approach-poster.webp 1920w, /media/video/airport-approach-poster-hd.webp 2560w" sizes="100vw" alt="" width="1920" height="1080" decoding="async" fetchpriority="high" />
      </picture>
      <canvas class="tt__canvas"></canvas>
      <div class="tt__stage stage-host" data-scene="airport-thread"></div>
      <div class="tt__veil"></div>
    </div>
    <div class="tt__body">
      <Hero lang={lang} />
      <Rests lang={lang} kind="services" title={t.nav.services} cards={services} still="corridor" />
      <Rests lang={lang} kind="gates" title={t.nav.categories} cards={categories} signs={signs} still="gates" />
    </div>
  </div>
  <Faq lang={lang} />
  <Cta lang={lang} />
</BaseLayout>

<style is:global>
  /* The film: one sticky screen behind hero → §2.2; the sections scroll over it. */
  .tt { position: relative; background: var(--color-bg); }
  .tt__film { position: sticky; inset: 0 auto auto 0; width: 100%; height: 100vh; height: 100lvh; overflow: hidden; background: var(--color-bg); }
  .tt__body { position: relative; margin-block-start: -100vh; margin-block-start: -100lvh; }
  .tt__still, .tt__canvas, .tt__veil { position: absolute; inset: 0; }
  .tt__still img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }   /* never mirrored */
  .tt__canvas { width: 100%; height: 100%; display: none; }
  .tt.is-film .tt__canvas { display: block; }
  .tt__film.is-painted .tt__still { visibility: hidden; }
  .tt__stage { z-index: 1; }
  /* the WebGL stage draws the film (its own grade, cuts, vignette and grain): our 2D copy steps aside */
  .tt__film:has(.tt__stage.is-drawing) .tt__canvas,
  .tt__film:has(.tt__stage.is-drawing) .tt__still,
  .tt__film:has(.tt__stage.is-drawing) .tt__veil { visibility: hidden; }
  /* css tier / before the stage draws: the same very light vignette as the shader */
  .tt__veil {
    pointer-events: none;
    background: radial-gradient(130% 100% at 50% 45%, transparent 62%, color-mix(in srgb, black 16%, transparent) 100%);   /* very light */
  }
  /* without JS: the film is the hero's still only; the other sections carry their own */
  html:not(.js) .tt__film { position: absolute; height: 100vh; height: 100svh; }
  html:not(.js) .tt__body { margin-block-start: 0; }
</style>
