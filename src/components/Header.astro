---
/**
 * Site header. Hide/show + solid state: motion/globals/header.ts
 * «خدمات التأشيرات» = a link to /visa-services/ + the submenu built like WaysZ's «خدماتنا» (`.has-sub` / `.sub`:
 * opens on hover and keyboard focus, no JS needed on wide screens). On top of it: a caret button (aria-expanded) that
 * toggles it — the only way to open it in the mobile menu — Esc closes it, ↑/↓ move between its links.
 * Two labelled groups from src/content/visas/ (brief v3 §1): «أنواع التأشيرات» (kind 'category', in its four groups
 * زيارة · دراسة · عمل · إقامة واستثمار) · «خدماتنا» (kind 'service'). Desktop: three columns (types take two).
 */
import { getCollection } from 'astro:content';
import { visaGroups } from '../content.config';
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { languages, localizePath, otherLang, switchLangPath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  overlay?: boolean;   // true = transparent over a dark hero until you scroll (home)
}
const { lang, overlay = false } = Astro.props;
const t = useTranslations(lang);
const to = otherLang(lang);
const here = Astro.url.pathname;

const visas = (await getCollection('visas')).sort((a, b) => a.data.order - b.data.order);
const item = (v: (typeof visas)[number]) => ({ href: localizePath(`/visa-services/${v.id}/`, lang), label: v.data[lang].name });
const categorySets = visaGroups.map((g) => ({
  id: `sub-group-${g}`, label: t.nav.groups[g],
  items: visas.filter((v) => v.data.kind === 'category' && v.data.group === g).map(item),
}));
const services = visas.filter((v) => v.data.kind === 'service').map(item);

// الرئيسية · خدمات التأشيرات ▾ · اعرف تأشيرتك · من نحن · تواصل معنا · WaysZ (external, the sister site)
const links = [
  { href: localizePath('/', lang), label: t.nav.home },
  { href: localizePath('/visa-services/', lang), label: t.nav.visaServices, sub: true },
  { href: localizePath('/assessment/', lang), label: t.nav.findVisa },
  { href: localizePath('/about/', lang), label: t.nav.about },
  { href: localizePath('/contact/', lang), label: t.nav.contact },
];
// the 404 page exists once (Arabic, with an English link): its language switch goes to the other home page
const switchHref = /^\/(en\/)?404\/?$/.test(here) ? localizePath('/', to) : switchLangPath(here, to);
const isCurrent = (href: string) =>
  href === localizePath('/', lang) ? here === href : here.startsWith(href);
---
<header class:list={['site-header theme-dark', { 'site-header--solid': !overlay }]} data-open="false">
  <div class="site-header__inner container">
    <a class="brand" href={localizePath('/', lang)} aria-label={t.a11y.home}>
      <Logo decorative class="brand__mark" />
      <span class="brand__word" aria-hidden="true">{site.name}</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label={t.nav.label} data-lenis-prevent>
      <ul role="list">
        {links.map((l) => (
          <li class:list={{ 'has-sub': l.sub }} data-sub-open={l.sub ? 'false' : undefined}>
            {l.sub ? (
              <>
                <span class="sub-head">
                  <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
                  <button class="sub-toggle" type="button" aria-expanded="false" aria-controls="sub-visas" aria-label={t.nav.submenu}>
                    <svg class="sub-toggle__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
                  </button>
                </span>
                <div class="sub" id="sub-visas">
                  <div class="sub__group sub__group--types">
                    <p class="sub__label">{t.nav.categories}</p>
                    <div class="sub__sets">
                      {categorySets.map((g) => (
                        <div class="sub__set">
                          <p class="sub__set-label" id={g.id}>{g.label}</p>
                          <ul role="list" aria-labelledby={g.id}>
                            {g.items.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="sub__group">
                    <p class="sub__label" id="sub-services">{t.nav.services}</p>
                    <ul role="list" aria-labelledby="sub-services">
                      {services.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>)}
                    </ul>
                  </div>
                </div>
              </>
            ) : (
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
            )}
          </li>
        ))}
        <li><a href={site.mainSite} rel="noopener">{t.nav.main}</a></li>
        <!-- mobile menu only: the header CTA is hidden under 1024px -->
        <li class="nav-cta"><a class="btn btn--accent" href={localizePath('/consultation/', lang)}>{t.cta.request}</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="lang" href={switchHref} hreflang={to} lang={to}>{languages[to]}</a>
      <a class="btn btn--accent cta" href={localizePath('/consultation/', lang)} data-magnetic>{t.cta.request}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
              data-label-open={t.nav.menu} data-label-close={t.nav.close}>
        <span class="visually-hidden">{t.nav.menu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { lenis } from '../motion/smooth-scroll';

  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const label = toggle.querySelector('.visually-hidden')!;

  const setOpen = (open: boolean) => {
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
    document.documentElement.classList.toggle('menu-open', open);
    if (open) lenis?.stop(); else lenis?.start();
  };
  toggle.addEventListener('click', () => {
    const open = header.dataset.open !== 'true';
    setOpen(open);
    // keyboard: the menu comes before the toggle in the DOM — move focus into it, keep Tab inside while it is open
    if (open) window.setTimeout(() => items()[0]?.focus({ preventScroll: true }), 60);
  });
  const nav = header.querySelector<HTMLElement>('#site-nav')!;
  const items = () => [...nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.getClientRects().length > 0);
  header.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || header.dataset.open !== 'true') return;
    const ring = [toggle, ...items()];
    const at = ring.indexOf(document.activeElement as HTMLElement);
    if (at < 0) return;
    const next = (at + (e.shiftKey ? -1 : 1) + ring.length) % ring.length;
    e.preventDefault();
    ring[next].focus();
  });

  // «خدمات التأشيرات» submenu. Wide screens: CSS opens it on hover / focus (like WaysZ); data-sub-open = opened
  // with the caret or the arrows; data-sub-hold = closed with Esc or the caret while the pointer / focus is still on it.
  const item = header.querySelector<HTMLElement>('.has-sub')!;
  const subToggle = item.querySelector<HTMLButtonElement>('.sub-toggle')!;
  const parent = item.querySelector<HTMLAnchorElement>('.sub-head a')!;
  const subLinks = [...item.querySelectorAll<HTMLAnchorElement>('.sub a')];
  const wide = matchMedia('(min-width: 1024px)');

  const setSub = (open: boolean) => {
    item.dataset.subOpen = String(open);
    subToggle.setAttribute('aria-expanded', String(open));
    if (open) delete item.dataset.subHold; else if (wide.matches) item.dataset.subHold = '';
  };
  subToggle.addEventListener('click', () => setSub(item.dataset.subOpen !== 'true'));
  item.addEventListener('mouseleave', () => { delete item.dataset.subHold; });
  item.addEventListener('focusout', (e) => {
    if (item.contains(e.relatedTarget as Node | null)) return;
    delete item.dataset.subHold;
    if (wide.matches) { item.dataset.subOpen = 'false'; subToggle.setAttribute('aria-expanded', 'false'); }
  });
  item.addEventListener('keydown', (e) => {
    const i = subLinks.indexOf(document.activeElement as HTMLAnchorElement);
    const go = (n: number) => { e.preventDefault(); setSub(true); subLinks[(n + subLinks.length) % subLinks.length].focus(); };
    if (e.key === 'ArrowDown') go(i + 1);
    else if (e.key === 'ArrowUp') go(i < 0 ? -1 : i - 1);
    else if (e.key === 'Home' && i >= 0) go(0);
    else if (e.key === 'End' && i >= 0) go(-1);
    else if (e.key === 'Escape' && item.dataset.subHold === undefined && (item.dataset.subOpen === 'true' || wide.matches)) {
      e.stopPropagation();                       // first Esc closes the submenu; the next one closes the mobile menu
      setSub(false);
      (i >= 0 ? parent : (document.activeElement as HTMLElement)).focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || header.dataset.open !== 'true') return;
    const inside = nav.contains(document.activeElement);
    setOpen(false);
    if (inside) toggle.focus();                  // back to the button that opened the menu
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-header);
    background: transparent;
    transition: transform var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }
  /* over the hero: a soft navy fade keeps the nav readable on bright sky */
  .site-header::before {
    content: ''; position: absolute; inset: 0 0 -40px 0; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 60%, transparent), transparent);
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .site-header:global(.is-solid)::before, .site-header:global(.is-hidden)::before,
  .site-header.site-header--solid::before { opacity: 0; }
  .site-header:global(.is-solid) {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }
  .site-header.site-header--solid { background: var(--color-bg); }
  /* without JS nothing can turn the overlay header solid: let it scroll away with the hero instead */
  :global(html:not(.js)) .site-header:not(.site-header--solid) { position: absolute; }
  .site-header:global(.is-hidden) { transform: translateY(-100%); }

  .site-header__inner {
    display: flex; align-items: center; gap: var(--space-5);
    min-height: 76px;
  }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .brand :global(.brand__mark) { width: 46px; }
  .brand__word { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-lg); }

  .site-nav { margin-inline-start: auto; }
  .site-nav ul { display: flex; gap: var(--space-5); }
  .site-nav a { text-decoration: none; font-size: var(--text-sm); color: var(--color-ink-muted); }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--color-ink); }
  .site-header:not(.site-header--solid):not(:global(.is-solid)) .site-nav > ul > li > a,
  .site-header:not(.site-header--solid):not(:global(.is-solid)) .site-nav > ul > li > .sub-head > a { color: var(--color-ink); }

  /* «خدمات التأشيرات» submenu — WaysZ's «خدماتنا» pattern: opens on hover and on keyboard focus (+ caret / arrows) */
  .has-sub { position: relative; }
  .sub-head { display: inline-flex; align-items: center; gap: var(--space-1); }
  .sub-toggle { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-sm); color: inherit; }
  .sub-toggle__caret { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: rotate var(--dur-fast) var(--ease-out); }
  .has-sub[data-sub-open='true'] .sub-toggle__caret { rotate: 180deg; }
  .sub__label { font-size: var(--text-xs); color: var(--color-ink-muted); margin-block-end: var(--space-2); }
  .sub__group ul { display: grid; gap: var(--space-1); }
  .sub__sets { display: grid; gap: var(--space-4); }
  .sub__set-label { font-size: var(--text-xs); font-weight: var(--weight-bold); color: var(--color-ink); margin-block-end: var(--space-1); }
  .nav-cta { display: none; }
  @media (min-width: 1024px) {
    /* the longer list (9 types in 4 groups + 9 services) opens as one panel centred under the header */
    .has-sub { position: static; }
    .site-nav .sub {
      position: absolute; top: 100%; inset-inline: 0; margin-inline: auto;
      display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-5);
      width: min(54rem, var(--container));
      padding: var(--space-4);
      background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      opacity: 0; visibility: hidden; translate: 0 -6px;
      transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
    }
    .site-nav .sub::before { content: ''; position: absolute; inset: -32px 0 100% 0; }  /* hover bridge up to the menu item */
    .has-sub:not([data-sub-hold]):hover .sub, .has-sub:not([data-sub-hold]):focus-within .sub,
    .has-sub[data-sub-open='true'] .sub { opacity: 1; visibility: visible; translate: 0 0; }
    .site-nav .sub ul { display: grid; gap: var(--space-1); }
    .site-nav .sub a { display: block; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); }
    .site-nav .sub a:hover { background: var(--color-surface); }
    .site-nav .sub__label, .site-nav .sub__set-label { padding-inline: var(--space-3); }
    .site-nav .sub__sets { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); }
    .site-nav .sub__group + .sub__group { border-inline-start: 1px solid var(--color-border); padding-inline-start: var(--space-5); }
  }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-4); }
  .lang { font-size: var(--text-sm); text-decoration: none; }

  .menu-toggle { display: none; width: 44px; height: 44px; place-items: center; }
  .menu-toggle__bars, .menu-toggle__bars::before, .menu-toggle__bars::after {
    display: block; width: 22px; height: 2px; background: currentColor; border-radius: 2px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .menu-toggle__bars { position: relative; }
  .menu-toggle__bars::before, .menu-toggle__bars::after { content: ''; position: absolute; inset-inline-start: 0; }
  .menu-toggle__bars::before { top: -7px; }
  .menu-toggle__bars::after { top: 7px; }

  @media (max-width: 1023px) {
    .menu-toggle { display: grid; }
    .cta { display: none; }
    .site-nav {
      position: fixed; inset: 76px 0 0 0;
      background: var(--color-bg);
      padding: var(--space-7) var(--space-6);
      opacity: 0; visibility: hidden;
      transition: opacity var(--dur-base) var(--ease-out), visibility var(--dur-base);
    }
    .site-nav ul { flex-direction: column; gap: var(--space-5); }
    /* the submenu folds under «خدمات التأشيرات»; the caret opens it */
    .sub-toggle { width: 44px; height: 44px; }
    .site-nav .sub { display: none; margin-block-start: var(--space-4); padding-inline-start: var(--space-4); border-inline-start: 1px solid var(--color-border); gap: var(--space-5); }
    .has-sub[data-sub-open='true'] .sub { display: grid; }
    .site-nav .sub ul { gap: var(--space-3); }
    .site-nav .sub a { font-size: var(--text-base); color: var(--color-ink-muted); }
    .nav-cta { display: block; }
    .site-nav .nav-cta a { font-size: var(--text-base); color: var(--color-on-accent); }
    .site-nav a { font-size: var(--text-xl); color: var(--color-ink); }
    .site-nav { overflow-y: auto; }
    .site-header[data-open='true'] .site-nav { opacity: 1; visibility: visible; }
    .site-header[data-open='true'] { background: var(--color-bg); }
    .site-header[data-open='true'] .menu-toggle__bars { background: transparent; }
    .site-header[data-open='true'] .menu-toggle__bars::before { transform: translateY(7px) rotate(45deg); }
    .site-header[data-open='true'] .menu-toggle__bars::after { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
