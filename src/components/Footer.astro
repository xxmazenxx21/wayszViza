---
/**
 * Site footer (brief v3 §1 «الفوتر»). Columns: quick links · visa types · our services · contact (src/lib/site.ts) ·
 * social; bottom row: privacy · terms · «جزء من WaysZ» + copyright. The plane "lands" here: motion/scenes/footer-landing.ts
 */
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { site, telHref, waHref, type SocialNetwork } from '../lib/site';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const visas = (await getCollection('visas')).sort((a, b) => a.data.order - b.data.order);
const list = (kind: 'category' | 'service') => visas
  .filter((v) => v.data.kind === kind)
  .map((v) => ({ href: localizePath(`/visa-services/${v.id}/`, lang), label: v.data[lang].name }));

const quick = [
  { href: localizePath('/', lang), label: t.nav.home },
  { href: localizePath('/visa-services/', lang), label: t.nav.visaServices },
  { href: localizePath('/assessment/', lang), label: t.nav.findVisa },
  { href: localizePath('/consultation/', lang), label: t.nav.consult },
  { href: localizePath('/about/', lang), label: t.nav.about },
  { href: localizePath('/contact/', lang), label: t.nav.contact },
];
const hasContact = !!(site.email || site.phone || site.whatsapp || site.address[lang] || site.hours[lang]);
const social = (Object.entries(site.social) as [SocialNetwork, string][]).filter(([, href]) => href);
---
<footer class="site-footer theme-dark" data-scene="footer-landing">
  <!-- touchdown: runway centre line + threshold lights (decorative) -->
  <div class="site-footer__runway" aria-hidden="true"><span class="site-footer__dashes"></span><span class="site-footer__lights"></span></div>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo class="site-footer__mark" />
      <p>{t.footer.about}</p>
    </div>

    <nav aria-label={t.footer.quickLinks}>
      <h2>{t.footer.quickLinks}</h2>
      <ul role="list">{quick.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label={t.nav.categories}>
      <h2>{t.nav.categories}</h2>
      <ul role="list">{list('category').map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label={t.nav.services}>
      <h2>{t.nav.services}</h2>
      <ul role="list">{list('service').map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    {hasContact && <div>
      <h2>{t.footer.contact}</h2>
      <ul role="list">
        {site.phone && <li><a href={telHref(site.phone)} dir="ltr"><bdi>{site.phone}</bdi></a></li>}
        {site.whatsapp && <li><a href={waHref(site.whatsapp, t.whatsapp.message)} rel="noopener">{t.cta.whatsapp}</a></li>}
        {site.email && <li><a href={`mailto:${site.email}`}><bdi>{site.email}</bdi></a></li>}
        {site.address[lang] && <li>{site.address[lang]}</li>}
        {site.hours[lang] && <li>{site.hours[lang]}</li>}
        {site.branches.map((b) => <li><a href={b.mapUrl} rel="noopener">{b.name[lang]}</a></li>)}
      </ul>
    </div>}

    {social.length > 0 && <div>
      <h2>{t.footer.social}</h2>
      <ul role="list">
        {social.map(([net, href]) => <li><a href={href} rel="noopener">{t.social[net]}</a></li>)}
      </ul>
    </div>}
  </div>

  <div class="container site-footer__bottom">
    <nav aria-label={t.footer.legal}>
      <ul role="list" class="site-footer__legal">
        <li><a href={localizePath('/privacy/', lang)}>{t.nav.privacy}</a></li>
        <li><a href={localizePath('/terms/', lang)}>{t.nav.terms}</a></li>
        <!-- brief part 04 §1.9: link to the main site -->
        <li><a href={site.mainSite} rel="noopener">{t.mainSite.title}</a></li>
      </ul>
    </nav>
    <p>© {year} {site.name}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; padding-block: var(--space-9) var(--space-6); overflow: hidden; }
  .site-footer__runway { position: absolute; inset-inline: 0; top: var(--space-7); height: 14px; pointer-events: none; }
  .site-footer__dashes {
    position: absolute; inset-block: 6px; inset-inline: -40% -40%; height: 2px;
    background: repeating-linear-gradient(to right, color-mix(in srgb, var(--color-ink) 34%, transparent) 0 56px, transparent 56px 104px);
  }
  .site-footer__lights {
    position: absolute; inset: 0; opacity: 0.9;
    background: radial-gradient(circle 3px at 50% 50%, var(--color-accent) 96%, transparent) 0 0 / 104px 14px repeat-x;
    -webkit-mask: linear-gradient(to right, transparent, black 20%, black 80%, transparent);
    mask: linear-gradient(to right, transparent, black 20%, black 80%, transparent);
  }
  .site-footer__grid {
    display: grid; gap: var(--space-7) var(--space-6);
    grid-template-columns: 1fr 1fr;
  }
  .site-footer__brand { grid-column: 1 / -1; }
  .site-footer__brand p { color: var(--color-ink-muted); max-width: 42ch; margin-block-start: var(--space-5); }
  .site-footer :global(.site-footer__mark) { width: 120px; }
  .site-footer h2 { font-size: var(--text-base); margin-block-end: var(--space-4); }
  .site-footer ul { display: grid; gap: var(--space-2); }
  .site-footer li { color: var(--color-ink-muted); }
  .site-footer a { color: var(--color-ink-muted); text-decoration: none; }
  .site-footer a:hover { color: var(--color-ink); }
  .site-footer__bottom {
    margin-block-start: var(--space-8); padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-border);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3) var(--space-6);
    color: var(--color-ink-muted); font-size: var(--text-xs);
  }
  .site-footer .site-footer__legal { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  @media (min-width: 1024px) {
    /* 9 types + 9 services: smaller, tighter lists and a one-line brand row keep the footer short */
    .site-footer__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: var(--space-6); }
    .site-footer__brand { display: flex; align-items: center; gap: var(--space-6); }
    .site-footer__brand p { margin-block-start: 0; }
    .site-footer :global(.site-footer__mark) { width: 96px; flex: none; }
    .site-footer__grid ul { gap: var(--space-1); font-size: var(--text-sm); line-height: 1.55; }
    .site-footer__grid h2 { margin-block-end: var(--space-3); }
    .site-footer__bottom { margin-block-start: var(--space-7); }
  }
  @media (min-width: 1440px) {
    .site-footer__grid { grid-template-columns: 1.3fr repeat(5, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: auto; display: block; }
    .site-footer__brand p { margin-block-start: var(--space-5); }
  }
  /* Curtain reveal on desktop — only where the whole footer fits the screen (it is taller than before: 9 + 9 links) */
  @media (min-width: 1024px) and (min-height: 860px) {
    .site-footer { position: sticky; bottom: 0; z-index: 0; }
  }
</style>
